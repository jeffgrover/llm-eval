});\n   console.log('--- t='+((i+1)*10)+'s ---\\n'+txt);\n }\n await page.screenshot({path:'/tmp/office_long.png',fullPage:false});\n console.log('ERRORS',errors.slice(0,20));\n await browser.close(); server.close();\n});\nEOF\nNODE_PATH=/home/jeff/Code/llm-eval/node_modules node /tmp/office_long.js \"$PWD\"","timeout":180}}}}
