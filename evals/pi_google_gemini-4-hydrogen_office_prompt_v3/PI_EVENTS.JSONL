eats and release them. I'm also building out the plan compilers, focusing on creating helper functions for elevator trips and outlining the initial steps for agents arriving at their desks, starting from the entrance.\n\n**Structuring Agent Activities**\n\nI'm defining the sequences of actions for agent activities. This involves mapping out the steps for going to lunch, including elevator trips and finding seats, and also detailing the core actions an agent takes once they are at their desk.\n\n**Adding Meeting Logic**\n\nI'm currently implementing the meeting attendance logic. This involves selecting meeting floors, reserving conference seats, and handling fallback scenarios where no seats are available. The plan now includes walking to the reserved seat and entering the meeting state.\n\n**Developing Agent Interaction Logic**\n\nI'm fleshing out the detailed action sequences for agents. This involves mapping out plans for attending meetings, including movement and seat reservation, and also defining how agents visit coworkers, navigating between floors and interactions.\n\n**Navigating Coworker Visits**\n\nI'm detailing the logic for agents visiting coworkers. This involves defining states for entering the \"VISITING\" phase, including waiting periods and moving to the colleague's desk. I'm also outlining the process for agents to leave the building, ensuring they correctly release seats and exit.\n\n**Exploring Exit Scenarios**\n\nI'm detailing the agent exit logic. This includes considering their current states, like being `IN_CAR` or `WAITING_ELEVATOR`, and how they proceed to `LEAVING` and `EXIT_BUILDING` when their `departureTime` arrives, ensuring all resources are released.\n\n"}}
{"type":"message_update","usage":{"input":2716,"output":17733,"cacheRead":48613,"cacheWrite":0,"reasoning":3160,"totalTokens":69062,"cost":{"input":0.0016296,"output":0.062065499999999996,"cacheRead":0.007778080000000001,"cacheWrite":0,"total":0.140717475,"totalFromProvider":true}},"assistantMessageEvent":{"type":"toolcall_end","contentIndex":1,"toolCall":{"type":"toolCall","id":"call_16883636211271184123","name":"write","arguments":{"path":"sim.js","content":"let scene = null;\nlet camera = null;\nlet renderer = null;\nlet controls = null;\nlet world = null;\nlet elevator = null;\nlet sunLight = null;\nlet ambientLight = null;\nlet hemiLight = null;\n\nconst MAX_WORKERS = 20;\nconst MAX_VISITORS = 80;\nconst MAX_OCCUPANCY = MAX_WORKERS + MAX_VISITORS;\nconst DEFAULT_OCCUPANCY = 45;\nconst WALK_SPEED = 1.35;\n\nlet targetOccupancy = DEFAULT_OCCUPANCY;\nconst agents = [];\nconst seatReservations = new Set();\nconst hudEls = {};\n\nconst FIRST_NAMES = [\n    \"Alex\", \"Sam\", \"Jordan\", \"Taylor\", \"Morgan\", \"Casey\", \"Riley\", \"Jamie\",\n    \"Drew\", \"Avery\", \"Quinn\", \"Blake\", \"Reese\", \"Parker\", \"Skyler\", \"Rowan\",\n    \"Elena\", \"Marcus\", \"Priya\", \"Liam\", \"Noah\", \"Maya\", \"Zoe\", \"Leo\",\n    \"Nora\", \"Owen\", \"Chloe\", \"Ethan\", \"Ruby\", \"Miles\"\n];\n\nfunction randInt(min, max) {\n    return Math.floor(Math.random() * (max - min + 1)) + min;\n}\n\nfunction randFloat(min, max) {\n    return Math.random() * (max - min) + min;\n}\n\nfunction pickRandom(arr) {\n    return arr[Math.floor(Math.random() * arr.length)];\n}\n\nconst simClock = {\n    simMinute: 7 * 60 + 30,\n    timeScale: 120,\n    tick: function (realDt) {\n        this.simMinute += (realDt * this.timeScale) / 60;\n        if (this.simMinute >= 24 * 60) {\n            this.simMinute -= 24 * 60;\n            resetDay();\n        }\n    },\n    format: function () {\n        const total = Math.floor(this.simMinute) % (24 * 60);\n        const h24 = Math.floor(total / 60);\n        const m = total % 60;\n        const ampm = h24 >= 12 ? \"PM\" : \"AM\";\n        let h12 = h24 % 12;\n        if (h12 === 0) h12 = 12;\n        const hStr = h12 < 10 ? \" \" + h12 : String(h12);\n        const mStr = m < 10 ? \"0\" + m : String(m);\n        return hStr + \":\" + mStr + \" \" + ampm;\n    }\n};\n\nconst LIGHTING_KEYFRAMES = [\n    { h: 0.0,  bg: 0x151822, sun: 0x334466, si: 0.12, ai: 0.45, hi: 0.32 },\n    { h: 5.5,  bg: 0x1a1e2e, sun: 0x445577, si: 0.15, ai: 0.45, hi: 0.32 },\n    { h: 6.0,  bg: 0x5d4a66, sun: 0xff8844, si: 0.45, ai: 0.50, hi: 0.38 },\n    { h: 6.5,  bg: 0x87b5d6, sun: 0xfff0d4, si: 0.90, ai: 0.52, hi: 0.48 },\n    { h: 12.0, bg: 0x99c8e8, sun: 0xffffff, si: 1.00, ai: 0.55, hi: 0.50 },\n    { h: 17.5, bg: 0x87b5d6, sun: 0xffe8c2, si: 0.88, ai: 0.52, hi: 0.46 },\n    { h: 18.0, bg: 0x6b4b63, sun: 0xff7733, si: 0.45, ai: 0.48, hi: 0.36 },\n    { h: 18.5, bg: 0x1c2030, sun: 0x334466, si: 0.14, ai: 0.45, hi: 0.32 },\n    { h: 24.0, bg: 0x151822, sun: 0x334466, si: 0.12, ai: 0.45, hi: 0.32 }\n];\n\nconst _tmpColorA = new THREE.Color();\nconst _tmpColorB = new THREE.Color();\n\nfunction updateLighting(simMinute) {\n    const h = (simMinute / 60) % 24;\n    let k0 = LIGHTING_KEYFRAMES[0];\n    let k1 = LIGHTING_KEYFRAMES[LIGHTING_KEYFRAMES.length - 1];\n    for (let i = 0; i < LIGHTING_KEYFRAMES.length - 1; i++) {\n        if (h >= LIGHTING_KEYFRAMES[i].h && h <= LIGHTING_KEYFRAMES[i + 1].h) {\n            k0 = LIGHTING_KEYFRAMES[i];\n            k1 = LIGHTING_KEYFRAMES[i + 1];\n            break;\n        }\n    }\n    const span = Math.max(0.0001, k1.h - k0.h);\n    const t = Math.max(0, Math.min(1, (h - k0.h) / span));\n\n    _tmpColorA.setHex(k0.bg);\n    _tmpColorB.setHex(k1.bg);\n    scene.background.copy(_tmpColorA).lerp(_tmpColorB, t);\n\n    _tmpColorA.setHex(k0.sun);\n    _tmpColorB.setHex(k1.sun);\n    sunLight.color.copy(_tmpColorA).lerp(_tmpColorB, t);\n\n    sunLight.intensity = k0.si + (k1.si - k0.si) * t;\n    ambientLight.intensity = k0.ai + (k1.ai - k0.ai) * t;\n    hemiLight.intensity = k0.hi + (k1.hi - k0.hi) * t;\n}\n\nfunction rollWorkerSchedule(agent) {\n    agent.arrivalTime = randInt(8 * 60 + 15, 9 * 60 + 30);\n    agent.lunchTime = randInt(11 * 60 + 30, 13 * 60 + 15);\n    agent.lunchDuration = randInt(25, 60);\n    agent.hasLunched = false;\n    if (Math.random() < 0.15) {\n        agent.departureTime = randInt(18 * 60 + 30, 19 * 60 + 45);\n    } else {\n        agent.departureTime = randInt(16 * 60 + 45, 18 * 60 + 30);\n    }\n    agent.plannedMeetingTimes = [];\n    const mCount = randInt(0, 2);\n    if (mCount >= 1) agent.plannedMeetingTimes.push(randInt(9 * 60 + 45, 11 * 60 + 15));\n    if (mCount >= 2) agent.plannedMeetingTimes.push(randInt(13 * 60 + 45, 16 * 60 + 15));\n}\n\nfunction rollVisitorSchedule(agent, baseMin) {\n    const start = baseMin !== undefined ? baseMin : 8 * 60 + 15;\n    agent.arrivalTime = start + randInt(0, 6);\n    agent.visitDuration = randInt(8, 28);\n    agent.lunchTime = 9999;\n    agent.lunchDuration = 0;\n    agent.hasLunched = true;\n    agent.departureTime = 9999;\n    agent.plannedMeetingTimes = [];\n}\n\nfunction createAgents() {\n    let idCounter = 0;\n    // 20 Workers (floors 1..5, 4 desks each)\n    for (let f = 1; f < WORLD.FLOOR_COUNT; f++) {\n        const fl = world.floors[f];\n        for (let d = 0; d < fl.desks.length; d++) {\n            const desk = fl.desks[d];\n            const mesh = createPerson();\n            const agent = {\n                id: idCounter++,\n                role: \"WORKER\",\n                name: pickRandom(FIRST_NAMES),\n                homeFloor: f,\n                deskId: desk.id,\n                deskWpName: desk.deskWpName,\n                deskDoorWpName: desk.doorWpName,\n                group: mesh,\n                state: \"AWAY\",\n                currentFloor: 0,\n                plan: [],\n                currentAction: null,\n                reservedSeatKey: null\n            };\n            rollWorkerSchedule(agent);\n            agents.push(agent);\n        }\n    }\n\n    // 80 Visitors\n    for (let v = 0; v < MAX_VISITORS; v++) {\n        const mesh = createPerson();\n        const agent = {\n            id: idCounter++,\n            role: \"VISITOR\",\n            name: pickRandom(FIRST_NAMES),\n            homeFloor: null,\n            deskId: null,\n            deskWpName: null,\n            deskDoorWpName: null,\n            group: mesh,\n            state: \"AWAY\",\n            currentFloor: 0,\n            plan: [],\n            currentAction: null,\n            reservedSeatKey: null\n        };\n        rollVisitorSchedule(agent, 8 * 60 + randInt(0, 120));\n        agents.push(agent);\n    }\n\n    applyOccupancy();\n}\n\nfunction releaseSeat(agent) {\n    if (agent.reservedSeatKey) {\n        seatReservations.delete(agent.reservedSeatKey);\n        agent.reservedSeatKey = null;\n    }\n}\n\nfunction reserveConfSeat(floor) {\n    for (let i = 0; i < 4; i++) {\n        const wpName = \"conf_seat\" + i;\n        const key = floor + \":\" + wpName;\n        if (!seatReservations.has(key)) {\n            seatReservations.add(key);\n            return { key: key, wpName: wpName };\n        }\n    }\n    return null;\n}\n\nfunction applyOccupancy() {\n    for (let i = 0; i < agents.length; i++) {\n        const a = agents[i];\n        if (a.id < targetOccupancy) {\n            if (a.state === \"DISABLED\") {\n                a.state = \"AWAY\";\n            }\n        } else {\n            if (a.state === \"AWAY\" || a.state === \"GONE\") {\n                a.state = \"DISABLED\";\n                if (a.group.parent) a.group.parent.remove(a.group);\n            }\n        }\n    }\n}\n\nfunction countPresent() {\n    let count = 0;\n    for (let i = 0; i < agents.length; i++) {\n        const s = agents[i].state;\n        if (s !== \"DISABLED\" && s !== \"AWAY\" && s !== \"GONE\") {\n            count++;\n        }\n    }\n    return count;\n}\n\nfunction topUpVisitors() {\n    if (simClock.simMinute < 7 * 60 + 30 || simClock.simMinute > 18 * 60 + 30) return;\n    const deficit = targetOccupancy - countPresent();\n    if (deficit <= 0) return;\n\n    let armed = 0;\n    for (let i = 0; i < agents.length; i++) {\n        const a = agents[i];\n        if (a.role !== \"VISITOR\" || a.id >= targetOccupancy) continue;\n        if (a.state === \"GONE\" || (a.state === \"AWAY\" && a.arrivalTime > simClock.simMinute + 12)) {\n            rollVisitorSchedule(a, simClock.simMinute);\n            a.state = \"AWAY\";\n            armed++;\n            if (armed >= deficit) break;\n        }\n    }\n}\n\nfunction resetDay() {\n    seatReservations.clear();\n    if (elevator) elevator.reset();\n\n    for (let i = 0; i < agents.length; i++) {\n        const a = agents[i];\n        if (a.group.parent) a.group.parent.remove(a.group);\n        a.group.userData.isWalking = false;\n        a.group.userData.isSitting = false;\n        a.plan = [];\n        a.currentAction = null;\n        a.reservedSeatKey = null;\n        a.currentFloor = 0;\n\n        if (a.role === \"WORKER\") {\n            rollWorkerSchedule(a);\n        } else {\n            rollVisitorSchedule(a, 8 * 60 + randInt(0, 90));\n        }\n        a.state = a.id < targetOccupancy ? \"AWAY\" : \"DISABLED\";\n    }\n}\n\n// --- Plan Compilers ---\n\nfunction addElevatorTrip(plan, fromFloor, toFloor) {\n    if (fromFloor === toFloor) return;\n    const dir = toFloor > fromFloor ? 1 : -1;\n    plan.push({ type: \"WALK_TO_WP\", floor: fromFloor, wpName: \"elevWait\" });\n    plan.push({ type: \"WAIT_AT_PANEL\", floor: fromFloor, dir: dir, toFloor: toFloor });\n    plan.push({ type: \"ENTER_ELEVATOR\", toFloor: toFloor });\n    plan.push({ type: \"PRESS_FLOOR\", floor: toFloor });\n    plan.push({ type: \"WAIT_FOR_FLOOR\", floor: toFloor });\n    plan.push({ type: \"EXIT_ELEVATOR\", toFloor: toFloor });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n}\n\nfunction planArriveToDesk(agent) {\n    const plan = [];\n    plan.push({ type: \"ENTER_STATE\", state: \"ARRIVING\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"front_door_threshold\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"entrance\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"lobby_center\" });\n    addElevatorTrip(plan, 0, agent.homeFloor);\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"SIT\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"ENTER_STATE\", state: \"AT_DESK\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(20, 55) });\n    plan.push({ type: \"PICK_NEXT_ACTIVITY\" });\n    return plan;\n}\n\nfunction planGoToLunch(agent) {\n    const plan = [];\n    const cafeSpots = world.floors[0].cafeSpots;\n    const bistroWp = pickRandom(cafeSpots);\n\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    addElevatorTrip(plan, agent.homeFloor, 0);\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: bistroWp });\n    plan.push({ type: \"SIT\", floor: 0, wpName: bistroWp });\n    plan.push({ type: \"ENTER_STATE\", state: \"AT_LUNCH\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: agent.lunchDuration });\n    plan.push({ type: \"MARK_LUNCHED\" });\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    addElevatorTrip(plan, 0, agent.homeFloor);\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"SIT\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"ENTER_STATE\", state: \"AT_DESK\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(20, 50) });\n    plan.push({ type: \"PICK_NEXT_ACTIVITY\" });\n    return plan;\n}\n\nfunction planVisitLounge(agent) {\n    const plan = [];\n    const spots = [\"lounge_spot0\", \"lounge_spot1\", \"lounge_spot2\", \"water_cooler\"];\n    const spot = pickRandom(spots);\n\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: spot });\n    plan.push({ type: \"SIT\", floor: agent.homeFloor, wpName: spot });\n    plan.push({ type: \"ENTER_STATE\", state: \"AT_BREAK\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(5, 12) });\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"SIT\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"ENTER_STATE\", state: \"AT_DESK\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(18, 50) });\n    plan.push({ type: \"PICK_NEXT_ACTIVITY\" });\n    return plan;\n}\n\nfunction planAttendMeeting(agent) {\n    const meetFloor = Math.random() < 0.65 ? agent.homeFloor : randInt(1, WORLD.FLOOR_COUNT - 1);\n    const seat = reserveConfSeat(meetFloor);\n    if (!seat) {\n        return planVisitLounge(agent);\n    }\n    agent.reservedSeatKey = seat.key;\n\n    const plan = [];\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    addElevatorTrip(plan, agent.homeFloor, meetFloor);\n    plan.push({ type: \"WALK_TO_WP\", floor: meetFloor, wpName: seat.wpName });\n    plan.push({ type: \"SIT\", floor: meetFloor, wpName: seat.wpName });\n    plan.push({ type: \"ENTER_STATE\", state: \"IN_MEETING\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(22, 45) });\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"RELEASE_SEAT\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    addElevatorTrip(plan, meetFloor, agent.homeFloor);\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"SIT\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"ENTER_STATE\", state: \"AT_DESK\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(18, 50) });\n    plan.push({ type: \"PICK_NEXT_ACTIVITY\" });\n    return plan;\n}\n\nfunction planVisitCoworker(agent) {\n    const candidates = [];\n    for (let i = 0; i < agents.length; i++) {\n        const other = agents[i];\n        if (other !== agent && other.role === \"WORKER\" && other.state === \"AT_DESK\") {\n            candidates.push(other);\n        }\n    }\n    if (candidates.length === 0) {\n        return planVisitLounge(agent);\n    }\n    const target = pickRandom(candidates);\n    const plan = [];\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    addElevatorTrip(plan, agent.homeFloor, target.homeFloor);\n    plan.push({ type: \"WALK_TO_WP\", floor: target.homeFloor, wpName: target.deskDoorWpName });\n    plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(6, 18) });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    addElevatorTrip(plan, target.homeFloor, agent.homeFloor);\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"SIT\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"ENTER_STATE\", state: \"AT_DESK\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(18, 50) });\n    plan.push({ type: \"PICK_NEXT_ACTIVITY\" });\n    return plan;\n}\n\nfunction planLeaveBuilding(agent) {\n    const plan = [];\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"RELEASE_SEAT\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"LEAVING\" });\n    if (agent.currentFloor > 0) {\n        addElevatorTrip(plan, agent.currentFloor, 0);\n    }\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"lobby_center\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"entrance\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"front_door_threshold\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"outside\" });\n    plan.push({ type: \"EXIT_BUILDING\" });\n    return plan;\n}\n\nfunction planVisitorVisit(agent) {\n    const plan = [];\n    plan.push({ type: \"ENTER_STATE\", state: \"ARRIVING\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"front_door_threshold\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"entrance\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"lobby_center\" });\n\n    const r = Math.random();\n    const dur = agent.visitDuration || randInt(8, 25);\n\n    if (r < 0.10) {\n        // Bistro table\n        const wp = pickRandom(world.floors[0].cafeSpots);\n        plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: wp });\n        plan.push({ type: \"SIT\", floor: 0, wpName: wp });\n        plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n        plan.push({ type: \"WAIT_SIM\", minutes: dur });\n        plan.push({ type: \"STAND\" });\n    } else if (r < 0.16) {\n        // Cafe counter\n        plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"cafe_order\" });\n        plan.push({ type: \"SIT\", floor: 0, wpName: \"cafe_order\" });\n        plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n        plan.push({ type: \"WAIT_SIM\", minutes: randInt(4, 10) });\n        plan.push({ type: \"STAND\" });\n    } else if (r < 0.30) {\n        // Front lounge\n        const wp = pickRandom([\"front_lounge_0\", \"front_lounge_1\", \"front_lounge_2\"]);\n        plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: wp });\n        plan.push({ type: \"SIT\", floor: 0, wpName: wp });\n        plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n        plan.push({ type: \"WAIT_SIM\", minutes: dur });\n        plan.push({ type: \"STAND\" });\n    } else if (r < 0.42) {\n        // Back lounge / conversation pit\n        const wp = pickRandom([\"back_lounge_N\", \"back_lounge_S\", \"pit_N\", \"pit_S\", \"pit_E\", \"pit_W\"]);\n        plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: wp });\n        plan.push({ type: \"SIT\", floor: 0, wpName: wp });\n        plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n        plan.push({ type: \"WAIT_SIM\", minutes: dur });\n        plan.push({ type: \"STAND\" });\n    } else if (r < 0.52) {\n        // Reception / kiosk / water cooler\n        const wp = pickRandom([\"reception\", \"kiosk\", \"lobby_wc_front\", \"lobby_wc_back\"]);\n        plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: wp });\n        plan.push({ type: \"SIT\", floor: 0, wpName: wp });\n        plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n        plan.push({ type: \"WAIT_SIM\", minutes: randInt(4, 12) });\n        plan.push({ type: \"STAND\" });\n    } else if (r < 0.62) {\n        // Lobby loiter\n        const wp = pickRandom([\"lobby_stand_center\", \"lobby_stand_NE\", \"lobby_stand_NW\", \"lobby_stand_midE\", \"lobby_stand_midW\", \"lobby_stand_entry\"]);\n        plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: wp });\n        plan.push({ type: \"SIT\", floor: 0, wpName: wp });\n        plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n        plan.push({ type: \"WAIT_SIM\", minutes: randInt(5, 15) });\n        plan.push({ type: \"STAND\" });\n    } else if (r < 0.77) {\n        // Ride up to an office-floor lounge\n        const upFloor = randInt(1, WORLD.FLOOR_COUNT - 1);\n        const wp = pickRandom([\"lounge_spot0\", \"lounge_spot1\", \"lounge_spot2\", \"water_cooler\", \"hall_stand_N\", \"hall_stand_S\"]);\n        addElevatorTrip(plan, 0, upFloor);\n        plan.push({ type: \"WALK_TO_WP\", floor: upFloor, wpName: wp });\n        plan.push({ type: \"SIT\", floor: upFloor, wpName: wp });\n        plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n        plan.push({ type: \"WAIT_SIM\", minutes: randInt(6, 16) });\n        plan.push({ type: \"STAND\" });\n        plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n        addElevatorTrip(plan, upFloor, 0);\n    } else {\n        // Sit in on a meeting (23%)\n        const meetFloor = randInt(1, WORLD.FLOOR_COUNT - 1);\n        const seat = reserveConfSeat(meetFloor);\n        if (seat) {\n            agent.reservedSeatKey = seat.key;\n            addElevatorTrip(plan, 0, meetFloor);\n            plan.push({ type: \"WALK_TO_WP\", floor: meetFloor, wpName: seat.wpName });\n            plan.push({ type: \"SIT\", floor: meetFloor, wpName: seat.wpName });\n            plan.push({ type: \"ENTER_STATE\", state: \"IN_MEETING\" });\n            plan.push({ type: \"WAIT_SIM\", minutes: randInt(15, 32) });\n            plan.push({ type: \"STAND\" });\n            plan.push({ type: \"RELEASE_SEAT\" });\n            plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n            addElevatorTrip(plan, meetFloor, 0);\n        } else {\n            const wp = pickRandom([\"lobby_stand_center\", \"lobby_stand_NE\", \"lobby_stand_NW\"]);\n            plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: wp });\n            plan.push({ type: \"SIT\", floor: 0, wpName: wp });\n            plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n            plan.push({ type: \"WAIT_SIM\", minutes: randInt(6, 14) });\n            plan.push({ type: \"STAND\" });\n        }\n    }\n\n    plan.push({ type: \"ENTER_STATE\", state: \"LEAVING\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"lobby_center\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"entrance\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"front_door_threshold\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"outside\" });\n    plan.push({ type: \"EXIT_BUILDING\" });\n    return plan;\n}\n\nfunction chooseNextActivity(agent) {\n    if (simClock.simMinute >= agent.departureTime) {\n        return planLeaveBuilding(agent);\n    }\n\n    if (agent.plannedMeetingTimes && agent.plannedMeetingTimes.length > 0) {\n        for (let i = 0; i < agent.plannedMeetingTimes.length; i++) {\n            if (simClock.simMinute >= agent.plannedMeetingTimes[i]) {\n                agent.plannedMeetingTimes.splice(i, 1);\n                return planAttendMeeting(agent);\n            }\n        }\n    }\n\n    if (!agent.hasLunched && simClock.simMinute >= agent.lunchTime) {\n        return planGoToLunch(agent);\n    }\n\n    const r = Math.random();\n    if (r < 0.14) {\n        return planAttendMeeting(agent);\n    } else if (r < 0.26) {\n        return planVisitLounge(agent);\n    } else if (r < 0.41) {\n        return planVisitCoworker(agent);\n    } else {\n        return [\n            { type: \"WAIT_SIM\", minutes: randInt(18, 65) },\n            { type: \"PICK_NEXT_ACTIVITY\" }\n        ];\n    }\n}\n\n// --- Action Execution ---\n\nfunction nearestNodeName(nodes, pos) {\n    let bestName = null;\n    let bestDistSq = Infinity;\n    const keys = Object.keys(nodes);\n    for (let i = 0; i < keys.length; i++) {\n        const k = keys[i];\n        const np = nodes[k].pos;\n        const dx = np.x - pos.x;\n        const dz = np.z - pos.z;\n        const d2 = dx * dx + dz * dz;\n        if (d2 < bestDistSq) {\n            bestDistSq = d2;\n            bestName = k;\n        }\n    }\n    return bestName;\n}\n\nfunction startAction(agent, action) {\n    agent.currentAction = action;\n    if (action.type === \"WALK_TO_WP\") {\n        const nodes = world.floors[action.floor].nodes;\n        const fromName = nearestNodeName(nodes, agent.group.position);\n        action.waypoints = bfsPath(nodes, fromName, action.wpName);\n        action.wpIdx = 0;\n        action._prevPos = agent.group.position.clone();\n        action._stallT = 0;\n        agent.group.userData.isWalking = true;\n        agent.group.userData.isSitting = false;\n    } else if (action.type === \"WAIT_AT_PANEL\") {\n        agent.group.userData.isWalking = false;\n    } else if (action.type === \"ENTER_ELEVATOR\") {\n        action.phase = \"reserve\";\n        action.spot = null;\n        action._prevPos = agent.group.position.clone();\n        action._stallT = 0;\n    } else if (action.type === \"EXIT_ELEVATOR\") {\n        // Reparent from carGroup to scene preserving world position\n        const worldPos = new THREE.Vector3();\n        agent.group.getWorldPosition(worldPos);\n        scene.add(agent.group);\n        agent.group.position.copy(worldPos);\n        agent.currentFloor = action.toFloor;\n        elevator.registerDisembark(agent);\n        const elevWaitPos = world.floors[action.toFloor].nodes.elevWait.pos.clone();\n        action.targetPos = elevWaitPos;\n        action._prevPos = agent.group.position.clone();\n        action._stallT = 0;\n        agent.group.userData.isWalking = true;\n    } else if (action.type === \"WAIT_SIM\") {\n        action.untilMin = simClock.simMinute + action.minutes;\n        agent.group.userData.isWalking = false;\n    }\n}\n\nfunction moveToward(pos, target, speed, dt) {\n    const dx = target.x - pos.x;\n    const dz = target.z - pos.z;\n    const dist = Math.hypot(dx, dz);\n    if (dist <= speed * dt + 0.05) {\n        pos.x = target.x;\n        pos.z = target.z;\n        return { arrived: true, dx: dx, dz: dz };\n    }\n    const step = (speed * dt) / dist;\n    pos.x += dx * step;\n    pos.z += dz * step;\n    return { arrived: false, dx: dx, dz: dz };\n}\n\nfunction stepAction(agent, dt) {\n    const action = agent.currentAction;\n    if (!action) return true;\n\n    if (action.type === \"ENTER_STATE\") {\n        agent.state = action.state;\n        return true;\n    }\n\n    if (action.type === \"MARK_LUNCHED\") {\n        agent.hasLunched = true;\n        return true;\n    }\n\n    if (action.type === \"RELEASE_SEAT\") {\n        releaseSeat(agent);\n        return true;\n    }\n\n    if (action.type === \"PICK_NEXT_ACTIVITY\") {\n        agent.plan = chooseNextActivity(agent);\n        return true;\n    }\n\n    if (action.type === \"EXIT_BUILDING\") {\n        if (agent.group.parent) agent.group.parent.remove(agent.group);\n        agent.group.userData.isWalking = false;\n        agent.group.userData.isSitting = false;\n        agent.state = \"GONE\";\n        agent.plan = [];\n        return true;\n    }\n\n    if (action.type === \"PRESS_FLOOR\") {\n        elevator.pressDestination(action.floor);\n        return true;\n    }\n\n    if (action.type === \"WAIT_FOR_FLOOR\") {\n        agent.group.userData.isWalking = false;\n        return elevator.state === \"DOOR_OPEN\" && elevator.currentFloor === action.floor;\n    }\n\n    if (action.type === \"SIT\") {\n        const fl = world.floors[action.floor];\n        const node = fl.nodes[action.wpName];\n        const st = fl.sitTargets[action.wpName];\n        agent.group.userData.isWalking = false;\n        if (node) {\n            agent.group.position.x = node.pos.x;\n            agent.group.position.z = node.pos.z;\n        }\n        if (st && st.sit) {\n            agent.group.position.y = action.floor * WORLD.FLOOR_HEIGHT - 0.35;\n            agent.group.rotation.y = st.facing;\n            agent.group.userData.isSitting = true;\n        } else {\n            // Standing waypoint: jitter in small ring so visitors don't stack identically\n            const angle = Math.random() * Math.PI * 2;\n            const radius = randFloat(0.35, 0.75);\n            agent.group.position.x += Math.cos(angle) * radius;\n            agent.group.position.z += Math.sin(angle) * radius;\n            agent.group.position.y = action.floor * WORLD.FLOOR_HEIGHT;\n            if (st) agent.group.rotation.y = st.facing;\n            agent.group.userData.isSitting = false;\n        }\n        return true;\n    }\n\n    if (action.type === \"STAND\") {\n        agent.group.userData.isSitting = false;\n        if (agent.group.parent === elevator.carGroup) {\n            agent.group.position.y = 0;\n        } else {\n            agent.group.position.y = agent.currentFloor * WORLD.FLOOR_HEIGHT;\n        }\n        return true;\n    }\n\n    if (action.type === \"WAIT_SIM\") {\n        return simClock.simMinute >= action.untilMin;\n    }\n\n    if (action.type === \"WALK_TO_WP\") {\n        if (!action.waypoints || action.wpIdx >= action.waypoints.length) {\n            agent.group.userData.isWalking = false;\n            return true;\n        }\n        const target = action.waypoints[action.wpIdx];\n        const res = moveToward(agent.group.position, target, WALK_SPEED, dt);\n        agent.group.position.y = action.floor * WORLD.FLOOR_HEIGHT;\n        if (Math.hypot(res.dx, res.dz) > 0.001) {\n            agent.group.rotation.y = Math.atan2(res.dx, res.dz);\n        }\n\n        const moved = Math.hypot(\n            agent.group.position.x - action._prevPos.x,\n            agent.group.position.z - action._prevPos.z\n        );\n        action._prevPos.copy(agent.group.position);\n        if (moved < 0.005) {\n            action._stallT += dt;\n            const stallLimit = action.wpName === \"front_door_threshold\" ? 1.5 : 1.2;\n            if (action._stallT > stallLimit) {\n                action._stallT = 0;\n                action.wpIdx++;\n                if (action.wpIdx >= action.waypoints.length) {\n                    agent.group.position.x = target.x;\n                    agent.group.position.z = target.z;\n                    agent.group.userData.isWalking = false;\n                    return true;\n                }\n                return false;\n            }\n        } else {\n            action._stallT = 0;\n        }\n\n        if (res.arrived) {\n            action.wpIdx++;\n            action._stallT = 0;\n            if (action.wpIdx >= action.waypoints.length) {\n                agent.group.userData.isWalking = false;\n                return true;\n            }\n        }\n        return false;\n    }\n\n    if (action.type === \"WAIT_AT_PANEL\") {\n        agent.state = \"WAITING_ELEVATOR\";\n        if (action.dir > 0) elevator.callUp(action.floor);\n        else elevator.callDown(action.floor);\n\n        if (elevator.isAcceptingAt(action.floor, action.dir) && elevator.currentCapacityFree() > 0) {\n            return true;\n        }\n        return false;\n    }\n\n    if (action.type === \"ENTER_ELEVATOR\") {\n        if (action.phase === \"reserve\") {\n            const dir = action.toFloor > agent.currentFloor ? 1 : -1;\n            if (!elevator.isAcceptingAt(agent.currentFloor, dir)) {\n                if (dir > 0) elevator.callUp(agent.currentFloor);\n                else elevator.callDown(agent.currentFloor);\n                return false;\n            }\n            const spot = elevator.reserveBoardingSpot(agent);\n            if (!spot) {\n                if (dir > 0) elevator.callUp(agent.currentFloor);\n                else elevator.callDown(agent.currentFloor);\n                return false;\n            }\n            action.spot = spot;\n            action.phase = \"toDoor\";\n            action._prevPos.copy(agent.group.position);\n            action._stallT = 0;\n            agent.group.userData.isWalking = true;\n            return false;\n        }\n\n        if (action.phase === \"toDoor\") {\n            const doorTarget = new THREE.Vector3(\n                action.spot.x,\n                agent.currentFloor * WORLD.FLOOR_HEIGHT,\n                1.55\n            );\n            const res = moveToward(agent.group.position, doorTarget, WALK_SPEED * 1.15, dt);\n            if (Math.hypot(res.dx, res.dz) > 0.001) {\n                agent.group.rotation.y = Math.atan2(res.dx, res.dz);\n            }\n            const moved = Math.hypot(\n                agent.group.position.x - action._prevPos.x,\n                agent.group.position.z - action._prevPos.z\n            );\n            action._prevPos.copy(agent.group.position);\n            if (moved < 0.005) {\n                action._stallT += dt;\n                if (action._stallT > 1.5) {\n                    agent.group.position.x = doorTarget.x;\n                    agent.group.position.z = doorTarget.z;\n                    res.arrived = true;\n                }\n            } else {\n                action._stallT = 0;\n            }\n\n            if (res.arrived) {\n                const worldPos = agent.group.position.clone();\n                elevator.carGroup.add(agent.group);\n                agent.group.position.set(\n                    worldPos.x - elevator.carGroup.position.x,\n                    0,\n                    worldPos.z - elevator.carGroup.position.z\n                );\n                action.phase = \"toSpot\";\n                action._prevPos.copy(agent.group.position);\n                action._stallT = 0;\n            }\n            return false;\n        }\n\n        if (action.phase === \"toSpot\") {\n            const spotTarget = new THREE.Vector3(action.spot.x, 0, action.spot.z);\n            const res = moveToward(agent.group.position, spotTarget, WALK_SPEED * 1.15, dt);\n            if (Math.hypot(res.dx, res.dz) > 0.001) {\n                agent.group.rotation.y = Math.atan2(res.dx, res.dz);\n            }\n            const moved = Math.hypot(\n                agent.group.position.x - action._prevPos.x,\n                agent.group.position.z - action._prevPos.z\n            );\n            action._prevPos.copy(agent.group.position);\n            if (moved < 0.005) {\n                action._stallT += dt;\n                if (action._stallT > 1.5) {\n                    agent.group.position.x = spotTarget.x;\n                    agent.group.position.z = spotTarget.z;\n                    res.arrived = true;\n                }\n            } else {\n                action._stallT = 0;\n            }\n\n            if (res.arrived) {\n                agent.group.position.set(action.spot.x, 0, action.spot.z);\n                agent.group.rotation.y = 0;\n                agent.group.userData.isWalking = false;\n                agent.state = \"IN_CAR\";\n                elevator.completeBoard(agent);\n                return true;\n            }\n            return false;\n        }\n    }\n\n    if (action.type === \"EXIT_ELEVATOR\") {\n        const res = moveToward(agent.group.position, action.targetPos, WALK_SPEED * 1.15, dt);\n        if (Math.hypot(res.dx, res.dz) > 0.001) {\n            agent.group.rotation.y = Math.atan2(res.dx, res.dz);\n        }\n        const moved = Math.hypot(\n            agent.group.position.x - action._prevPos.x,\n            agent.group.position.z - action._prevPos.z\n        );\n        action._prevPos.copy(agent.group.position);\n        if (moved < 0.005) {\n            action._stallT += dt;\n            if (action._stallT > 1.5) {\n                agent.group.position.x = action.targetPos.x;\n                agent.group.position.z = action.targetPos.z;\n                res.arrived = true;\n            }\n        } else {\n            action._stallT = 0;\n        }\n\n        if (res.arrived) {\n            elevator.completeDisembark(agent);\n            agent.group.userData.isWalking = false;\n            return true;\n        }\n        return false;\n    }\n\n    return true;\n}\n\nfunction updateAgent(agent, dt) {\n    if (agent.state === \"DISABLED\" || agent.state === \"GONE\") return;\n\n    if (agent.state === \"AWAY\") {\n        if (simClock.simMinute >= agent.arrivalTime) {\n            const outsidePos = world.floors[0].nodes.outside.pos;\n            agent.group.position.set(\n                outsidePos.x + randFloat(-1.1, 1.1),\n                0,\n                outsidePos.z + randFloat(-0.75, 0.75)\n            );\n            agent.group.rotation.y = Math.PI;\n            agent.currentFloor = 0;\n            scene.add(agent.group);\n            if (agent.role === \"WORKER\") {\n                agent.plan = planArriveToDesk(agent);\n            } else {\n                agent.plan = planVisitorVisit(agent);\n            }\n            agent.currentAction = null;\n        } else {\n            return;\n        }\n    }\n\n    // Worker end-of-day check while idle at desk\n    if (\n        agent.role === \"WORKER\" &&\n        agent.state === \"AT_DESK\" &&\n        simClock.simMinute >= agent.departureTime &&\n        agent.currentAction &&\n        agent.currentAction.type === \"WAIT_SIM\"\n    ) {\n        agent.plan = planLeaveBuilding(agent);\n        agent.currentAction = null;\n    }\n\n    // Action dispatch loop (up to 16 transitions per frame)\n    for (let iter = 0; iter < 16; iter++) {\n        if (!agent.currentAction) {\n            if (agent.plan.length === 0) break;\n            const next = agent.plan.shift();\n            startAction(agent, next);\n        }\n        const done = stepAction(agent, dt);\n        if (done) {\n            agent.currentAction = null;\n            if (agent.state === \"GONE\" || agent.state === \"DISABLED\") break;\n        } else {\n            break;\n        }\n    }\n}\n\nconst ENTRANCE_WPS = {\n    outside: true,\n    front_door_threshold: true,\n    entrance: true,\n    lobby_center: true\n};\n\nfunction isCollisionExempt(agent) {\n    if (agent.state === \"DISABLED\" || agent.state === \"AWAY\" || agent.state === \"GONE\") return true;\n    if (agent.group.userData.isSitting) return true;\n    if (agent.group.parent === elevator.carGroup) return true;\n    if (!agent.group.parent) return true;\n    if (agent.currentAction) {\n        if (agent.currentAction.type === \"ENTER_ELEVATOR\") return true;\n        if (\n            agent.currentAction.type === \"WALK_TO_WP\" &&\n            agent.currentAction.floor === 0 &&\n            ENTRANCE_WPS[agent.currentAction.wpName]\n        ) {\n            return true;\n        }\n    }\n    return false;\n}\n\nfunction applyCollisions() {\n    const minSep = WORLD.PERSON_R * 1.75; // ~0.7\n    const pushScalar = 0.18;\n\n    for (let i = 0; i < agents.length; i++) {\n        const a = agents[i];\n        if (isCollisionExempt(a)) continue;\n\n        for (let j = i + 1; j < agents.length; j++) {\n            const b = agents[j];\n            if (isCollisionExempt(b)) continue;\n            if (a.group.parent !== b.group.parent) continue;\n            if (Math.abs(a.group.position.y - b.group.position.y) > 1.0) continue;\n\n            let dx = a.group.position.x - b.group.position.x;\n            let dz = a.group.position.z - b.group.position.z;\n            let d = Math.hypot(dx, dz);\n\n            if (d < minSep) {\n                if (d < 1e-3) {\n                    const ang = Math.random() * Math.PI * 2;\n                    dx = Math.cos(ang);\n                    dz = Math.sin(ang);\n                    d = 1;\n                } else {\n                    dx /= d;\n                    dz /= d;\n                }\n                const overlap = (minSep - d) * pushScalar;\n                a.group.position.x += dx * overlap;\n                a.group.position.z += dz * overlap;\n                b.group.position.x -= dx * overlap;\n                b.group.position.z -= dz * overlap;\n            }\n        }\n    }\n}\n\n// --- HUD ---\n\nfunction createHUD() {\n    const panel = document.createElement(\"div\");\n    panel.style.position = \"fixed\";\n    panel.style.top = \"12px\";\n    panel.style.left = \"12px\";\n    panel.style.padding = \"12px 14px\";\n    panel.style.background = \"rgba(18, 22, 30, 0.82)\";\n    panel.style.color = \"#e8edf5\";\n    panel.style.fontFamily = \"monospace\";\n    panel.style.fontSize = \"12px\";\n    panel.style.borderRadius = \"8px\";\n    panel.style.border = \"1px solid rgba(255,255,255,0.14)\";\n    panel.style.minWidth = \"235px\";\n    panel.style.zIndex = \"100\";\n\n    const timeEl = document.createElement(\"div\");\n    timeEl.style.fontSize = \"22px\";\n    timeEl.style.fontWeight = \"bold\";\n    timeEl.style.color = \"#ffbb22\";\n    timeEl.style.marginBottom = \"8px\";\n    panel.appendChild(timeEl);\n\n    // Speed slider (log-spaced 1..600)\n    const speedLabel = document.createElement(\"div\");\n    speedLabel.textContent = \"Speed: 120x\";\n    panel.appendChild(speedLabel);\n\n    const speedSlider = document.createElement(\"input\");\n    speedSlider.type = \"range\";\n    speedSlider.min = \"0\";\n    speedSlider.max = \"100\";\n    speedSlider.value = String(Math.round((Math.log(120) / Math.log(600)) * 100));\n    speedSlider.style.width = \"100%\";\n    speedSlider.style.marginBottom = \"6px\";\n    speedSlider.addEventListener(\"input\", (event) => {\n        const frac = Number(event.target.value) / 100;\n        const val = Math.round(Math.pow(600, frac));\n        simClock.timeScale = Math.max(1, Math.min(600, val));\n        speedLabel.textContent = \"Speed: \" + simClock.timeScale + \"x\";\n    });\n    panel.appendChild(speedSlider);\n\n    // Occupancy slider (1..100)\n    const occLabel = document.createElement(\"div\");\n    occLabel.textContent = \"Occupancy: \" + targetOccupancy + \" / \" + MAX_OCCUPANCY + \" people\";\n    panel.appendChild(occLabel);\n\n    const occSlider = document.createElement(\"input\");\n    occSlider.type = \"range\";\n    occSlider.min = \"1\";\n    occSlider.max = String(MAX_OCCUPANCY);\n    occSlider.value = String(targetOccupancy);\n    occSlider.style.width = \"100%\";\n    occSlider.style.marginBottom = \"8px\";\n    occSlider.addEventListener(\"input\", (event) => {\n        targetOccupancy = Number(event.target.value);\n        occLabel.textContent = \"Occupancy: \" + targetOccupancy + \" / \" + MAX_OCCUPANCY + \" people\";\n        applyOccupancy();\n    });\n    panel.appendChild(occSlider);\n\n    const statsEl = document.createElement(\"div\");\n    statsEl.style.lineHeight = \"1.45\";\n    statsEl.style.whiteSpace = \"pre\";\n    panel.appendChild(statsEl);\n\n    document.body.appendChild(panel);\n    hudEls.timeEl = timeEl;\n    hudEls.statsEl = statsEl;\n}\n\nfunction updateHUD() {\n    if (!hudEls.timeEl) return;\n    hudEls.timeEl.textContent = simClock.format();\n\n    const counts = {};\n    for (let i = 0; i < agents.length; i++) {\n        const s = agents[i].state;\n        counts[s] = (counts[s] || 0) + 1;\n    }\n\n    const dirChar = elevator.direction > 0 ? \"^\" : (elevator.direction < 0 ? \"v\" : \"-\");\n    const dests = Array.from(elevator.destinations).sort().join(\",\") || \"-\";\n    const ups = Array.from(elevator.upCalls).sort().join(\",\") || \"-\";\n    const dns = Array.from(elevator.downCalls).sort().join(\",\") || \"-\";\n\n    const lines = [\n        \"Present: \" + countPresent() + \" / \" + targetOccupancy,\n        \"Elevator: F\" + elevator.currentFloor + \" \" + dirChar + \" (\" + elevator.state + \")\",\n        \"Car: \" + elevator.passengers.size + \"/4  Dests:[\" + dests + \"]\",\n        \"Calls: U[\" + ups + \"] D[\" + dns + \"]\",\n        \"AT_DESK:\" + (counts.AT_DESK || 0) + \" MEET:\" + (counts.IN_MEETING || 0),\n        \"WAIT:\" + (counts.WAITING_ELEVATOR || 0) + \" VISIT:\" + (counts.VISITING || 0),\n        \"LUNCH:\" + (counts.AT_LUNCH || 0) + \" BREAK:\" + (counts.AT_BREAK || 0)\n    ];\n    hudEls.statsEl.textContent = lines.join(\"\\n\");\n}\n\nfunction startSimulation() {\n    scene = new THREE.Scene();\n    scene.background = new THREE.Color(0x20242a);\n    camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);\n    camera.position.set(28, 24, 28);\n\n    renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n    renderer.setSize(window.innerWidth, window.innerHeight);\n    renderer.sortObjects = true;\n    document.body.appendChild(renderer.domElement);\n\n    controls = new THREE.OrbitControls(camera, renderer.domElement);\n    controls.target.set(0, 9, 0);\n    controls.update();\n\n    ambientLight = new THREE.AmbientLight(0xffffff, 0.45);\n    scene.add(ambientLight);\n\n    hemiLight = new THREE.HemisphereLight(0xbfd7ff, 0x303020, 0.45);\n    scene.add(hemiLight);\n\n    sunLight = new THREE.DirectionalLight(0xffffff, 0.9);\n    sunLight.position.set(20, 35, 18);\n    scene.add(sunLight);\n\n    world = createWorld(scene);\n    elevator = new Elevator(scene, world);\n    createAgents();\n    createHUD();\n\n    window.addEventListener(\"resize\", () => {\n        camera.aspect = window.innerWidth / window.innerHeight;\n        camera.updateProjectionMatrix();\n        renderer.setSize(window.innerWidth, window.innerHeight);\n    });\n\n    const frameClock = new THREE.Clock();\n\n    function animate() {\n        requestAnimationFrame(animate);\n        const realDt = Math.min(0.05, frameClock.getDelta());\n        simClock.tick(realDt);\n        updateLighting(simClock.simMinute);\n\n        const motionDt = realDt * simClock.timeScale;\n        elevator.tick(motionDt);\n\n        topUpVisitors();\n        for (let i = 0; i < agents.length; i++) {\n            updateAgent(agents[i], motionDt);\n        }\n\n        applyCollisions();\n\n        for (let i = 0; i < agents.length; i++) {\n            const a = agents[i];\n            if (a.group.parent) {\n                animatePersonWalking(a.group, motionDt);\n            }\n        }\n\n        controls.update();\n        renderer.render(scene, camera);\n        updateHUD();\n    }\n\n    animate();\n}\n\nif (document.readyState === \"loading\") {\n    window.addEventListener(\"DOMContentLoaded\", startSimulation);\n} else {\n    startSimulation();\n}\n"}}}}
{"type":"message_end","message":{"role":"assistant","content":[{"type":"thinking","thinking":"**Drafting sim.js Code**\n\nI'm now focusing on implementing `sim.js`, carefully reviewing each requirement. This includes setting up top-level variables like `scene`, `camera`, `renderer`, and `world`, while ensuring no duplicate declarations and defining constants such as `MAX_WORKERS`.\n\n**Building Core Simulation**\n\nI'm currently integrating the foundational elements of the simulation logic. This involves setting up essential constants like maximum occupancy and defining initial states for agents and seat reservations. The simulated clock is also being refined to handle time progression and day/night cycles accurately.\n\n**Refining Agent Logic**\n\nMy focus has shifted to the nuanced behavior of agents. I'm meticulously detailing the movement and interaction logic for both workers and visitors, ensuring their schedules and desk assignments are accurately reflected within the simulation's environment.\n\n**Implementing Scene Dynamics**\n\nI'm working on the dynamic elements of the scene, specifically the day and night lighting transitions. The keyframes are being adjusted to create realistic ambient and hemispheric lighting changes throughout the 24-hour cycle, enhancing the visual immersion of the simulation.\n\n**Adjusting Visitor Logic**\n\nI'm refining visitor behavior, specifically how they re-enter the simulation. When it's business hours and occupancy is low, I'm enabling agents who were `AWAY` or `GONE` to become active again, re-calculating their visit durations.\n\n**Defining Reservation Logic**\n\nI'm detailing the seat reservation system, implementing functions to find available conference room seats and release them. I'm also building out the plan compilers, focusing on creating helper functions for elevator trips and outlining the initial steps for agents arriving at their desks, starting from the entrance.\n\n**Structuring Agent Activities**\n\nI'm defining the sequences of actions for agent activities. This involves mapping out the steps for going to lunch, including elevator trips and finding seats, and also detailing the core actions an agent takes once they are at their desk.\n\n**Adding Meeting Logic**\n\nI'm currently implementing the meeting attendance logic. This involves selecting meeting floors, reserving conference seats, and handling fallback scenarios where no seats are available. The plan now includes walking to the reserved seat and entering the meeting state.\n\n**Developing Agent Interaction Logic**\n\nI'm fleshing out the detailed action sequences for agents. This involves mapping out plans for attending meetings, including movement and seat reservation, and also defining how agents visit coworkers, navigating between floors and interactions.\n\n**Navigating Coworker Visits**\n\nI'm detailing the logic for agents visiting coworkers. This involves defining states for entering the \"VISITING\" phase, including waiting periods and moving to the colleague's desk. I'm also outlining the process for agents to leave the building, ensuring they correctly release seats and exit.\n\n**Exploring Exit Scenarios**\n\nI'm detailing the agent exit logic. This includes considering their current states, like being `IN_CAR` or `WAITING_ELEVATOR`, and how they proceed to `LEAVING` and `EXIT_BUILDING` when their `departureTime` arrives, ensuring all resources are released.\n\n","thinkingSignature":"[{\"type\":\"reasoning.text\",\"text\":\"**Drafting sim.js Code**\\n\\nI'm now focusing on implementing `sim.js`, carefully reviewing each requirement. This includes setting up top-level variables like `scene`, `camera`, `renderer`, and `world`, while ensuring no duplicate declarations and defining constants such as `MAX_WORKERS`.\\n\\n**Building Core Simulation**\\n\\nI'm currently integrating the foundational elements of the simulation logic. This involves setting up essential constants like maximum occupancy and defining initial states for agents and seat reservations. The simulated clock is also being refined to handle time progression and day/night cycles accurately.\\n\\n**Refining Agent Logic**\\n\\nMy focus has shifted to the nuanced behavior of agents. I'm meticulously detailing the movement and interaction logic for both workers and visitors, ensuring their schedules and desk assignments are accurately reflected within the simulation's environment.\\n\\n**Implementing Scene Dynamics**\\n\\nI'm working on the dynamic elements of the scene, specifically the day and night lighting transitions. The keyframes are being adjusted to create realistic ambient and hemispheric lighting changes throughout the 24-hour cycle, enhancing the visual immersion of the simulation.\\n\\n**Adjusting Visitor Logic**\\n\\nI'm refining visitor behavior, specifically how they re-enter the simulation. When it's business hours and occupancy is low, I'm enabling agents who were `AWAY` or `GONE` to become active again, re-calculating their visit durations.\\n\\n**Defining Reservation Logic**\\n\\nI'm detailing the seat reservation system, implementing functions to find available conference room seats and release them. I'm also building out the plan compilers, focusing on creating helper functions for elevator trips and outlining the initial steps for agents arriving at their desks, starting from the entrance.\\n\\n**Structuring Agent Activities**\\n\\nI'm defining the sequences of actions for agent activities. This involves mapping out the steps for going to lunch, including elevator trips and finding seats, and also detailing the core actions an agent takes once they are at their desk.\\n\\n**Adding Meeting Logic**\\n\\nI'm currently implementing the meeting attendance logic. This involves selecting meeting floors, reserving conference seats, and handling fallback scenarios where no seats are available. The plan now includes walking to the reserved seat and entering the meeting state.\\n\\n**Developing Agent Interaction Logic**\\n\\nI'm fleshing out the detailed action sequences for agents. This involves mapping out plans for attending meetings, including movement and seat reservation, and also defining how agents visit coworkers, navigating between floors and interactions.\\n\\n**Navigating Coworker Visits**\\n\\nI'm detailing the logic for agents visiting coworkers. This involves defining states for entering the \\\"VISITING\\\" phase, including waiting periods and moving to the colleague's desk. I'm also outlining the process for agents to leave the building, ensuring they correctly release seats and exit.\\n\\n**Exploring Exit Scenarios**\\n\\nI'm detailing the agent exit logic. This includes considering their current states, like being `IN_CAR` or `WAITING_ELEVATOR`, and how they proceed to `LEAVING` and `EXIT_BUILDING` when their `departureTime` arrives, ensuring all resources are released.\\n\\n\",\"format\":\"google-gemini-v1\",\"index\":0},{\"type\":\"reasoning.encrypted\",\"data\":\".eyJlbmRwb2ludF9zbHVnIjoiZ29vZ2xlL2dlbWluaS00LWh5ZHJvZ2VuLTIwMjYxMTEyfGdvb2dsZS12ZXJ0ZXgvZ2xvYmFsIn0\",\"format\":\"google-gemini-v1\",\"id\":\"call_16883636211271184123\",\"index\":0}]"},{"type":"toolCall","id":"call_16883636211271184123","name":"write","arguments":{"path":"sim.js","content":"let scene = null;\nlet camera = null;\nlet renderer = null;\nlet controls = null;\nlet world = null;\nlet elevator = null;\nlet sunLight = null;\nlet ambientLight = null;\nlet hemiLight = null;\n\nconst MAX_WORKERS = 20;\nconst MAX_VISITORS = 80;\nconst MAX_OCCUPANCY = MAX_WORKERS + MAX_VISITORS;\nconst DEFAULT_OCCUPANCY = 45;\nconst WALK_SPEED = 1.35;\n\nlet targetOccupancy = DEFAULT_OCCUPANCY;\nconst agents = [];\nconst seatReservations = new Set();\nconst hudEls = {};\n\nconst FIRST_NAMES = [\n    \"Alex\", \"Sam\", \"Jordan\", \"Taylor\", \"Morgan\", \"Casey\", \"Riley\", \"Jamie\",\n    \"Drew\", \"Avery\", \"Quinn\", \"Blake\", \"Reese\", \"Parker\", \"Skyler\", \"Rowan\",\n    \"Elena\", \"Marcus\", \"Priya\", \"Liam\", \"Noah\", \"Maya\", \"Zoe\", \"Leo\",\n    \"Nora\", \"Owen\", \"Chloe\", \"Ethan\", \"Ruby\", \"Miles\"\n];\n\nfunction randInt(min, max) {\n    return Math.floor(Math.random() * (max - min + 1)) + min;\n}\n\nfunction randFloat(min, max) {\n    return Math.random() * (max - min) + min;\n}\n\nfunction pickRandom(arr) {\n    return arr[Math.floor(Math.random() * arr.length)];\n}\n\nconst simClock = {\n    simMinute: 7 * 60 + 30,\n    timeScale: 120,\n    tick: function (realDt) {\n        this.simMinute += (realDt * this.timeScale) / 60;\n        if (this.simMinute >= 24 * 60) {\n            this.simMinute -= 24 * 60;\n            resetDay();\n        }\n    },\n    format: function () {\n        const total = Math.floor(this.simMinute) % (24 * 60);\n        const h24 = Math.floor(total / 60);\n        const m = total % 60;\n        const ampm = h24 >= 12 ? \"PM\" : \"AM\";\n        let h12 = h24 % 12;\n        if (h12 === 0) h12 = 12;\n        const hStr = h12 < 10 ? \" \" + h12 : String(h12);\n        const mStr = m < 10 ? \"0\" + m : String(m);\n        return hStr + \":\" + mStr + \" \" + ampm;\n    }\n};\n\nconst LIGHTING_KEYFRAMES = [\n    { h: 0.0,  bg: 0x151822, sun: 0x334466, si: 0.12, ai: 0.45, hi: 0.32 },\n    { h: 5.5,  bg: 0x1a1e2e, sun: 0x445577, si: 0.15, ai: 0.45, hi: 0.32 },\n    { h: 6.0,  bg: 0x5d4a66, sun: 0xff8844, si: 0.45, ai: 0.50, hi: 0.38 },\n    { h: 6.5,  bg: 0x87b5d6, sun: 0xfff0d4, si: 0.90, ai: 0.52, hi: 0.48 },\n    { h: 12.0, bg: 0x99c8e8, sun: 0xffffff, si: 1.00, ai: 0.55, hi: 0.50 },\n    { h: 17.5, bg: 0x87b5d6, sun: 0xffe8c2, si: 0.88, ai: 0.52, hi: 0.46 },\n    { h: 18.0, bg: 0x6b4b63, sun: 0xff7733, si: 0.45, ai: 0.48, hi: 0.36 },\n    { h: 18.5, bg: 0x1c2030, sun: 0x334466, si: 0.14, ai: 0.45, hi: 0.32 },\n    { h: 24.0, bg: 0x151822, sun: 0x334466, si: 0.12, ai: 0.45, hi: 0.32 }\n];\n\nconst _tmpColorA = new THREE.Color();\nconst _tmpColorB = new THREE.Color();\n\nfunction updateLighting(simMinute) {\n    const h = (simMinute / 60) % 24;\n    let k0 = LIGHTING_KEYFRAMES[0];\n    let k1 = LIGHTING_KEYFRAMES[LIGHTING_KEYFRAMES.length - 1];\n    for (let i = 0; i < LIGHTING_KEYFRAMES.length - 1; i++) {\n        if (h >= LIGHTING_KEYFRAMES[i].h && h <= LIGHTING_KEYFRAMES[i + 1].h) {\n            k0 = LIGHTING_KEYFRAMES[i];\n            k1 = LIGHTING_KEYFRAMES[i + 1];\n            break;\n        }\n    }\n    const span = Math.max(0.0001, k1.h - k0.h);\n    const t = Math.max(0, Math.min(1, (h - k0.h) / span));\n\n    _tmpColorA.setHex(k0.bg);\n    _tmpColorB.setHex(k1.bg);\n    scene.background.copy(_tmpColorA).lerp(_tmpColorB, t);\n\n    _tmpColorA.setHex(k0.sun);\n    _tmpColorB.setHex(k1.sun);\n    sunLight.color.copy(_tmpColorA).lerp(_tmpColorB, t);\n\n    sunLight.intensity = k0.si + (k1.si - k0.si) * t;\n    ambientLight.intensity = k0.ai + (k1.ai - k0.ai) * t;\n    hemiLight.intensity = k0.hi + (k1.hi - k0.hi) * t;\n}\n\nfunction rollWorkerSchedule(agent) {\n    agent.arrivalTime = randInt(8 * 60 + 15, 9 * 60 + 30);\n    agent.lunchTime = randInt(11 * 60 + 30, 13 * 60 + 15);\n    agent.lunchDuration = randInt(25, 60);\n    agent.hasLunched = false;\n    if (Math.random() < 0.15) {\n        agent.departureTime = randInt(18 * 60 + 30, 19 * 60 + 45);\n    } else {\n        agent.departureTime = randInt(16 * 60 + 45, 18 * 60 + 30);\n    }\n    agent.plannedMeetingTimes = [];\n    const mCount = randInt(0, 2);\n    if (mCount >= 1) agent.plannedMeetingTimes.push(randInt(9 * 60 + 45, 11 * 60 + 15));\n    if (mCount >= 2) agent.plannedMeetingTimes.push(randInt(13 * 60 + 45, 16 * 60 + 15));\n}\n\nfunction rollVisitorSchedule(agent, baseMin) {\n    const start = baseMin !== undefined ? baseMin : 8 * 60 + 15;\n    agent.arrivalTime = start + randInt(0, 6);\n    agent.visitDuration = randInt(8, 28);\n    agent.lunchTime = 9999;\n    agent.lunchDuration = 0;\n    agent.hasLunched = true;\n    agent.departureTime = 9999;\n    agent.plannedMeetingTimes = [];\n}\n\nfunction createAgents() {\n    let idCounter = 0;\n    // 20 Workers (floors 1..5, 4 desks each)\n    for (let f = 1; f < WORLD.FLOOR_COUNT; f++) {\n        const fl = world.floors[f];\n        for (let d = 0; d < fl.desks.length; d++) {\n            const desk = fl.desks[d];\n            const mesh = createPerson();\n            const agent = {\n                id: idCounter++,\n                role: \"WORKER\",\n                name: pickRandom(FIRST_NAMES),\n                homeFloor: f,\n                deskId: desk.id,\n                deskWpName: desk.deskWpName,\n                deskDoorWpName: desk.doorWpName,\n                group: mesh,\n                state: \"AWAY\",\n                currentFloor: 0,\n                plan: [],\n                currentAction: null,\n                reservedSeatKey: null\n            };\n            rollWorkerSchedule(agent);\n            agents.push(agent);\n        }\n    }\n\n    // 80 Visitors\n    for (let v = 0; v < MAX_VISITORS; v++) {\n        const mesh = createPerson();\n        const agent = {\n            id: idCounter++,\n            role: \"VISITOR\",\n            name: pickRandom(FIRST_NAMES),\n            homeFloor: null,\n            deskId: null,\n            deskWpName: null,\n            deskDoorWpName: null,\n            group: mesh,\n            state: \"AWAY\",\n            currentFloor: 0,\n            plan: [],\n            currentAction: null,\n            reservedSeatKey: null\n        };\n        rollVisitorSchedule(agent, 8 * 60 + randInt(0, 120));\n        agents.push(agent);\n    }\n\n    applyOccupancy();\n}\n\nfunction releaseSeat(agent) {\n    if (agent.reservedSeatKey) {\n        seatReservations.delete(agent.reservedSeatKey);\n        agent.reservedSeatKey = null;\n    }\n}\n\nfunction reserveConfSeat(floor) {\n    for (let i = 0; i < 4; i++) {\n        const wpName = \"conf_seat\" + i;\n        const key = floor + \":\" + wpName;\n        if (!seatReservations.has(key)) {\n            seatReservations.add(key);\n            return { key: key, wpName: wpName };\n        }\n    }\n    return null;\n}\n\nfunction applyOccupancy() {\n    for (let i = 0; i < agents.length; i++) {\n        const a = agents[i];\n        if (a.id < targetOccupancy) {\n            if (a.state === \"DISABLED\") {\n                a.state = \"AWAY\";\n            }\n        } else {\n            if (a.state === \"AWAY\" || a.state === \"GONE\") {\n                a.state = \"DISABLED\";\n                if (a.group.parent) a.group.parent.remove(a.group);\n            }\n        }\n    }\n}\n\nfunction countPresent() {\n    let count = 0;\n    for (let i = 0; i < agents.length; i++) {\n        const s = agents[i].state;\n        if (s !== \"DISABLED\" && s !== \"AWAY\" && s !== \"GONE\") {\n            count++;\n        }\n    }\n    return count;\n}\n\nfunction topUpVisitors() {\n    if (simClock.simMinute < 7 * 60 + 30 || simClock.simMinute > 18 * 60 + 30) return;\n    const deficit = targetOccupancy - countPresent();\n    if (deficit <= 0) return;\n\n    let armed = 0;\n    for (let i = 0; i < agents.length; i++) {\n        const a = agents[i];\n        if (a.role !== \"VISITOR\" || a.id >= targetOccupancy) continue;\n        if (a.state === \"GONE\" || (a.state === \"AWAY\" && a.arrivalTime > simClock.simMinute + 12)) {\n            rollVisitorSchedule(a, simClock.simMinute);\n            a.state = \"AWAY\";\n            armed++;\n            if (armed >= deficit) break;\n        }\n    }\n}\n\nfunction resetDay() {\n    seatReservations.clear();\n    if (elevator) elevator.reset();\n\n    for (let i = 0; i < agents.length; i++) {\n        const a = agents[i];\n        if (a.group.parent) a.group.parent.remove(a.group);\n        a.group.userData.isWalking = false;\n        a.group.userData.isSitting = false;\n        a.plan = [];\n        a.currentAction = null;\n        a.reservedSeatKey = null;\n        a.currentFloor = 0;\n\n        if (a.role === \"WORKER\") {\n            rollWorkerSchedule(a);\n        } else {\n            rollVisitorSchedule(a, 8 * 60 + randInt(0, 90));\n        }\n        a.state = a.id < targetOccupancy ? \"AWAY\" : \"DISABLED\";\n    }\n}\n\n// --- Plan Compilers ---\n\nfunction addElevatorTrip(plan, fromFloor, toFloor) {\n    if (fromFloor === toFloor) return;\n    const dir = toFloor > fromFloor ? 1 : -1;\n    plan.push({ type: \"WALK_TO_WP\", floor: fromFloor, wpName: \"elevWait\" });\n    plan.push({ type: \"WAIT_AT_PANEL\", floor: fromFloor, dir: dir, toFloor: toFloor });\n    plan.push({ type: \"ENTER_ELEVATOR\", toFloor: toFloor });\n    plan.push({ type: \"PRESS_FLOOR\", floor: toFloor });\n    plan.push({ type: \"WAIT_FOR_FLOOR\", floor: toFloor });\n    plan.push({ type: \"EXIT_ELEVATOR\", toFloor: toFloor });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n}\n\nfunction planArriveToDesk(agent) {\n    const plan = [];\n    plan.push({ type: \"ENTER_STATE\", state: \"ARRIVING\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"front_door_threshold\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"entrance\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"lobby_center\" });\n    addElevatorTrip(plan, 0, agent.homeFloor);\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"SIT\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"ENTER_STATE\", state: \"AT_DESK\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(20, 55) });\n    plan.push({ type: \"PICK_NEXT_ACTIVITY\" });\n    return plan;\n}\n\nfunction planGoToLunch(agent) {\n    const plan = [];\n    const cafeSpots = world.floors[0].cafeSpots;\n    const bistroWp = pickRandom(cafeSpots);\n\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    addElevatorTrip(plan, agent.homeFloor, 0);\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: bistroWp });\n    plan.push({ type: \"SIT\", floor: 0, wpName: bistroWp });\n    plan.push({ type: \"ENTER_STATE\", state: \"AT_LUNCH\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: agent.lunchDuration });\n    plan.push({ type: \"MARK_LUNCHED\" });\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    addElevatorTrip(plan, 0, agent.homeFloor);\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"SIT\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"ENTER_STATE\", state: \"AT_DESK\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(20, 50) });\n    plan.push({ type: \"PICK_NEXT_ACTIVITY\" });\n    return plan;\n}\n\nfunction planVisitLounge(agent) {\n    const plan = [];\n    const spots = [\"lounge_spot0\", \"lounge_spot1\", \"lounge_spot2\", \"water_cooler\"];\n    const spot = pickRandom(spots);\n\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: spot });\n    plan.push({ type: \"SIT\", floor: agent.homeFloor, wpName: spot });\n    plan.push({ type: \"ENTER_STATE\", state: \"AT_BREAK\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(5, 12) });\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"SIT\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"ENTER_STATE\", state: \"AT_DESK\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(18, 50) });\n    plan.push({ type: \"PICK_NEXT_ACTIVITY\" });\n    return plan;\n}\n\nfunction planAttendMeeting(agent) {\n    const meetFloor = Math.random() < 0.65 ? agent.homeFloor : randInt(1, WORLD.FLOOR_COUNT - 1);\n    const seat = reserveConfSeat(meetFloor);\n    if (!seat) {\n        return planVisitLounge(agent);\n    }\n    agent.reservedSeatKey = seat.key;\n\n    const plan = [];\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    addElevatorTrip(plan, agent.homeFloor, meetFloor);\n    plan.push({ type: \"WALK_TO_WP\", floor: meetFloor, wpName: seat.wpName });\n    plan.push({ type: \"SIT\", floor: meetFloor, wpName: seat.wpName });\n    plan.push({ type: \"ENTER_STATE\", state: \"IN_MEETING\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(22, 45) });\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"RELEASE_SEAT\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    addElevatorTrip(plan, meetFloor, agent.homeFloor);\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"SIT\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"ENTER_STATE\", state: \"AT_DESK\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(18, 50) });\n    plan.push({ type: \"PICK_NEXT_ACTIVITY\" });\n    return plan;\n}\n\nfunction planVisitCoworker(agent) {\n    const candidates = [];\n    for (let i = 0; i < agents.length; i++) {\n        const other = agents[i];\n        if (other !== agent && other.role === \"WORKER\" && other.state === \"AT_DESK\") {\n            candidates.push(other);\n        }\n    }\n    if (candidates.length === 0) {\n        return planVisitLounge(agent);\n    }\n    const target = pickRandom(candidates);\n    const plan = [];\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    addElevatorTrip(plan, agent.homeFloor, target.homeFloor);\n    plan.push({ type: \"WALK_TO_WP\", floor: target.homeFloor, wpName: target.deskDoorWpName });\n    plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(6, 18) });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    addElevatorTrip(plan, target.homeFloor, agent.homeFloor);\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"SIT\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"ENTER_STATE\", state: \"AT_DESK\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(18, 50) });\n    plan.push({ type: \"PICK_NEXT_ACTIVITY\" });\n    return plan;\n}\n\nfunction planLeaveBuilding(agent) {\n    const plan = [];\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"RELEASE_SEAT\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"LEAVING\" });\n    if (agent.currentFloor > 0) {\n        addElevatorTrip(plan, agent.currentFloor, 0);\n    }\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"lobby_center\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"entrance\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"front_door_threshold\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"outside\" });\n    plan.push({ type: \"EXIT_BUILDING\" });\n    return plan;\n}\n\nfunction planVisitorVisit(agent) {\n    const plan = [];\n    plan.push({ type: \"ENTER_STATE\", state: \"ARRIVING\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"front_door_threshold\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"entrance\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"lobby_center\" });\n\n    const r = Math.random();\n    const dur = agent.visitDuration || randInt(8, 25);\n\n    if (r < 0.10) {\n        // Bistro table\n        const wp = pickRandom(world.floors[0].cafeSpots);\n        plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: wp });\n        plan.push({ type: \"SIT\", floor: 0, wpName: wp });\n        plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n        plan.push({ type: \"WAIT_SIM\", minutes: dur });\n        plan.push({ type: \"STAND\" });\n    } else if (r < 0.16) {\n        // Cafe counter\n        plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"cafe_order\" });\n        plan.push({ type: \"SIT\", floor: 0, wpName: \"cafe_order\" });\n        plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n        plan.push({ type: \"WAIT_SIM\", minutes: randInt(4, 10) });\n        plan.push({ type: \"STAND\" });\n    } else if (r < 0.30) {\n        // Front lounge\n        const wp = pickRandom([\"front_lounge_0\", \"front_lounge_1\", \"front_lounge_2\"]);\n        plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: wp });\n        plan.push({ type: \"SIT\", floor: 0, wpName: wp });\n        plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n        plan.push({ type: \"WAIT_SIM\", minutes: dur });\n        plan.push({ type: \"STAND\" });\n    } else if (r < 0.42) {\n        // Back lounge / conversation pit\n        const wp = pickRandom([\"back_lounge_N\", \"back_lounge_S\", \"pit_N\", \"pit_S\", \"pit_E\", \"pit_W\"]);\n        plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: wp });\n        plan.push({ type: \"SIT\", floor: 0, wpName: wp });\n        plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n        plan.push({ type: \"WAIT_SIM\", minutes: dur });\n        plan.push({ type: \"STAND\" });\n    } else if (r < 0.52) {\n        // Reception / kiosk / water cooler\n        const wp = pickRandom([\"reception\", \"kiosk\", \"lobby_wc_front\", \"lobby_wc_back\"]);\n        plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: wp });\n        plan.push({ type: \"SIT\", floor: 0, wpName: wp });\n        plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n        plan.push({ type: \"WAIT_SIM\", minutes: randInt(4, 12) });\n        plan.push({ type: \"STAND\" });\n    } else if (r < 0.62) {\n        // Lobby loiter\n        const wp = pickRandom([\"lobby_stand_center\", \"lobby_stand_NE\", \"lobby_stand_NW\", \"lobby_stand_midE\", \"lobby_stand_midW\", \"lobby_stand_entry\"]);\n        plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: wp });\n        plan.push({ type: \"SIT\", floor: 0, wpName: wp });\n        plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n        plan.push({ type: \"WAIT_SIM\", minutes: randInt(5, 15) });\n        plan.push({ type: \"STAND\" });\n    } else if (r < 0.77) {\n        // Ride up to an office-floor lounge\n        const upFloor = randInt(1, WORLD.FLOOR_COUNT - 1);\n        const wp = pickRandom([\"lounge_spot0\", \"lounge_spot1\", \"lounge_spot2\", \"water_cooler\", \"hall_stand_N\", \"hall_stand_S\"]);\n        addElevatorTrip(plan, 0, upFloor);\n        plan.push({ type: \"WALK_TO_WP\", floor: upFloor, wpName: wp });\n        plan.push({ type: \"SIT\", floor: upFloor, wpName: wp });\n        plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n        plan.push({ type: \"WAIT_SIM\", minutes: randInt(6, 16) });\n        plan.push({ type: \"STAND\" });\n        plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n        addElevatorTrip(plan, upFloor, 0);\n    } else {\n        // Sit in on a meeting (23%)\n        const meetFloor = randInt(1, WORLD.FLOOR_COUNT - 1);\n        const seat = reserveConfSeat(meetFloor);\n        if (seat) {\n            agent.reservedSeatKey = seat.key;\n            addElevatorTrip(plan, 0, meetFloor);\n            plan.push({ type: \"WALK_TO_WP\", floor: meetFloor, wpName: seat.wpName });\n            plan.push({ type: \"SIT\", floor: meetFloor, wpName: seat.wpName });\n            plan.push({ type: \"ENTER_STATE\", state: \"IN_MEETING\" });\n            plan.push({ type: \"WAIT_SIM\", minutes: randInt(15, 32) });\n            plan.push({ type: \"STAND\" });\n            plan.push({ type: \"RELEASE_SEAT\" });\n            plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n            addElevatorTrip(plan, meetFloor, 0);\n        } else {\n            const wp = pickRandom([\"lobby_stand_center\", \"lobby_stand_NE\", \"lobby_stand_NW\"]);\n            plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: wp });\n            plan.push({ type: \"SIT\", floor: 0, wpName: wp });\n            plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n            plan.push({ type: \"WAIT_SIM\", minutes: randInt(6, 14) });\n            plan.push({ type: \"STAND\" });\n        }\n    }\n\n    plan.push({ type: \"ENTER_STATE\", state: \"LEAVING\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"lobby_center\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"entrance\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"front_door_threshold\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"outside\" });\n    plan.push({ type: \"EXIT_BUILDING\" });\n    return plan;\n}\n\nfunction chooseNextActivity(agent) {\n    if (simClock.simMinute >= agent.departureTime) {\n        return planLeaveBuilding(agent);\n    }\n\n    if (agent.plannedMeetingTimes && agent.plannedMeetingTimes.length > 0) {\n        for (let i = 0; i < agent.plannedMeetingTimes.length; i++) {\n            if (simClock.simMinute >= agent.plannedMeetingTimes[i]) {\n                agent.plannedMeetingTimes.splice(i, 1);\n                return planAttendMeeting(agent);\n            }\n        }\n    }\n\n    if (!agent.hasLunched && simClock.simMinute >= agent.lunchTime) {\n        return planGoToLunch(agent);\n    }\n\n    const r = Math.random();\n    if (r < 0.14) {\n        return planAttendMeeting(agent);\n    } else if (r < 0.26) {\n        return planVisitLounge(agent);\n    } else if (r < 0.41) {\n        return planVisitCoworker(agent);\n    } else {\n        return [\n            { type: \"WAIT_SIM\", minutes: randInt(18, 65) },\n            { type: \"PICK_NEXT_ACTIVITY\" }\n        ];\n    }\n}\n\n// --- Action Execution ---\n\nfunction nearestNodeName(nodes, pos) {\n    let bestName = null;\n    let bestDistSq = Infinity;\n    const keys = Object.keys(nodes);\n    for (let i = 0; i < keys.length; i++) {\n        const k = keys[i];\n        const np = nodes[k].pos;\n        const dx = np.x - pos.x;\n        const dz = np.z - pos.z;\n        const d2 = dx * dx + dz * dz;\n        if (d2 < bestDistSq) {\n            bestDistSq = d2;\n            bestName = k;\n        }\n    }\n    return bestName;\n}\n\nfunction startAction(agent, action) {\n    agent.currentAction = action;\n    if (action.type === \"WALK_TO_WP\") {\n        const nodes = world.floors[action.floor].nodes;\n        const fromName = nearestNodeName(nodes, agent.group.position);\n        action.waypoints = bfsPath(nodes, fromName, action.wpName);\n        action.wpIdx = 0;\n        action._prevPos = agent.group.position.clone();\n        action._stallT = 0;\n        agent.group.userData.isWalking = true;\n        agent.group.userData.isSitting = false;\n    } else if (action.type === \"WAIT_AT_PANEL\") {\n        agent.group.userData.isWalking = false;\n    } else if (action.type === \"ENTER_ELEVATOR\") {\n        action.phase = \"reserve\";\n        action.spot = null;\n        action._prevPos = agent.group.position.clone();\n        action._stallT = 0;\n    } else if (action.type === \"EXIT_ELEVATOR\") {\n        // Reparent from carGroup to scene preserving world position\n        const worldPos = new THREE.Vector3();\n        agent.group.getWorldPosition(worldPos);\n        scene.add(agent.group);\n        agent.group.position.copy(worldPos);\n        agent.currentFloor = action.toFloor;\n        elevator.registerDisembark(agent);\n        const elevWaitPos = world.floors[action.toFloor].nodes.elevWait.pos.clone();\n        action.targetPos = elevWaitPos;\n        action._prevPos = agent.group.position.clone();\n        action._stallT = 0;\n        agent.group.userData.isWalking = true;\n    } else if (action.type === \"WAIT_SIM\") {\n        action.untilMin = simClock.simMinute + action.minutes;\n        agent.group.userData.isWalking = false;\n    }\n}\n\nfunction moveToward(pos, target, speed, dt) {\n    const dx = target.x - pos.x;\n    const dz = target.z - pos.z;\n    const dist = Math.hypot(dx, dz);\n    if (dist <= speed * dt + 0.05) {\n        pos.x = target.x;\n        pos.z = target.z;\n        return { arrived: true, dx: dx, dz: dz };\n    }\n    const step = (speed * dt) / dist;\n    pos.x += dx * step;\n    pos.z += dz * step;\n    return { arrived: false, dx: dx, dz: dz };\n}\n\nfunction stepAction(agent, dt) {\n    const action = agent.currentAction;\n    if (!action) return true;\n\n    if (action.type === \"ENTER_STATE\") {\n        agent.state = action.state;\n        return true;\n    }\n\n    if (action.type === \"MARK_LUNCHED\") {\n        agent.hasLunched = true;\n        return true;\n    }\n\n    if (action.type === \"RELEASE_SEAT\") {\n        releaseSeat(agent);\n        return true;\n    }\n\n    if (action.type === \"PICK_NEXT_ACTIVITY\") {\n        agent.plan = chooseNextActivity(agent);\n        return true;\n    }\n\n    if (action.type === \"EXIT_BUILDING\") {\n        if (agent.group.parent) agent.group.parent.remove(agent.group);\n        agent.group.userData.isWalking = false;\n        agent.group.userData.isSitting = false;\n        agent.state = \"GONE\";\n        agent.plan = [];\n        return true;\n    }\n\n    if (action.type === \"PRESS_FLOOR\") {\n        elevator.pressDestination(action.floor);\n        return true;\n    }\n\n    if (action.type === \"WAIT_FOR_FLOOR\") {\n        agent.group.userData.isWalking = false;\n        return elevator.state === \"DOOR_OPEN\" && elevator.currentFloor === action.floor;\n    }\n\n    if (action.type === \"SIT\") {\n        const fl = world.floors[action.floor];\n        const node = fl.nodes[action.wpName];\n        const st = fl.sitTargets[action.wpName];\n        agent.group.userData.isWalking = false;\n        if (node) {\n            agent.group.position.x = node.pos.x;\n            agent.group.position.z = node.pos.z;\n        }\n        if (st && st.sit) {\n            agent.group.position.y = action.floor * WORLD.FLOOR_HEIGHT - 0.35;\n            agent.group.rotation.y = st.facing;\n            agent.group.userData.isSitting = true;\n        } else {\n            // Standing waypoint: jitter in small ring so visitors don't stack identically\n            const angle = Math.random() * Math.PI * 2;\n            const radius = randFloat(0.35, 0.75);\n            agent.group.position.x += Math.cos(angle) * radius;\n            agent.group.position.z += Math.sin(angle) * radius;\n            agent.group.position.y = action.floor * WORLD.FLOOR_HEIGHT;\n            if (st) agent.group.rotation.y = st.facing;\n            agent.group.userData.isSitting = false;\n        }\n        return true;\n    }\n\n    if (action.type === \"STAND\") {\n        agent.group.userData.isSitting = false;\n        if (agent.group.parent === elevator.carGroup) {\n            agent.group.position.y = 0;\n        } else {\n            agent.group.position.y = agent.currentFloor * WORLD.FLOOR_HEIGHT;\n        }\n        return true;\n    }\n\n    if (action.type === \"WAIT_SIM\") {\n        return simClock.simMinute >= action.untilMin;\n    }\n\n    if (action.type === \"WALK_TO_WP\") {\n        if (!action.waypoints || action.wpIdx >= action.waypoints.length) {\n            agent.group.userData.isWalking = false;\n            return true;\n        }\n        const target = action.waypoints[action.wpIdx];\n        const res = moveToward(agent.group.position, target, WALK_SPEED, dt);\n        agent.group.position.y = action.floor * WORLD.FLOOR_HEIGHT;\n        if (Math.hypot(res.dx, res.dz) > 0.001) {\n            agent.group.rotation.y = Math.atan2(res.dx, res.dz);\n        }\n\n        const moved = Math.hypot(\n            agent.group.position.x - action._prevPos.x,\n            agent.group.position.z - action._prevPos.z\n        );\n        action._prevPos.copy(agent.group.position);\n        if (moved < 0.005) {\n            action._stallT += dt;\n            const stallLimit = action.wpName === \"front_door_threshold\" ? 1.5 : 1.2;\n            if (action._stallT > stallLimit) {\n                action._stallT = 0;\n                action.wpIdx++;\n                if (action.wpIdx >= action.waypoints.length) {\n                    agent.group.position.x = target.x;\n                    agent.group.position.z = target.z;\n                    agent.group.userData.isWalking = false;\n                    return true;\n                }\n                return false;\n            }\n        } else {\n            action._stallT = 0;\n        }\n\n        if (res.arrived) {\n            action.wpIdx++;\n            action._stallT = 0;\n            if (action.wpIdx >= action.waypoints.length) {\n                agent.group.userData.isWalking = false;\n                return true;\n            }\n        }\n        return false;\n    }\n\n    if (action.type === \"WAIT_AT_PANEL\") {\n        agent.state = \"WAITING_ELEVATOR\";\n        if (action.dir > 0) elevator.callUp(action.floor);\n        else elevator.callDown(action.floor);\n\n        if (elevator.isAcceptingAt(action.floor, action.dir) && elevator.currentCapacityFree() > 0) {\n            return true;\n        }\n        return false;\n    }\n\n    if (action.type === \"ENTER_ELEVATOR\") {\n        if (action.phase === \"reserve\") {\n            const dir = action.toFloor > agent.currentFloor ? 1 : -1;\n            if (!elevator.isAcceptingAt(agent.currentFloor, dir)) {\n                if (dir > 0) elevator.callUp(agent.currentFloor);\n                else elevator.callDown(agent.currentFloor);\n                return false;\n            }\n            const spot = elevator.reserveBoardingSpot(agent);\n            if (!spot) {\n                if (dir > 0) elevator.callUp(agent.currentFloor);\n                else elevator.callDown(agent.currentFloor);\n                return false;\n            }\n            action.spot = spot;\n            action.phase = \"toDoor\";\n            action._prevPos.copy(agent.group.position);\n            action._stallT = 0;\n            agent.group.userData.isWalking = true;\n            return false;\n        }\n\n        if (action.phase === \"toDoor\") {\n            const doorTarget = new THREE.Vector3(\n                action.spot.x,\n                agent.currentFloor * WORLD.FLOOR_HEIGHT,\n                1.55\n            );\n            const res = moveToward(agent.group.position, doorTarget, WALK_SPEED * 1.15, dt);\n            if (Math.hypot(res.dx, res.dz) > 0.001) {\n                agent.group.rotation.y = Math.atan2(res.dx, res.dz);\n            }\n            const moved = Math.hypot(\n                agent.group.position.x - action._prevPos.x,\n                agent.group.position.z - action._prevPos.z\n            );\n            action._prevPos.copy(agent.group.position);\n            if (moved < 0.005) {\n                action._stallT += dt;\n                if (action._stallT > 1.5) {\n                    agent.group.position.x = doorTarget.x;\n                    agent.group.position.z = doorTarget.z;\n                    res.arrived = true;\n                }\n            } else {\n                action._stallT = 0;\n            }\n\n            if (res.arrived) {\n                const worldPos = agent.group.position.clone();\n                elevator.carGroup.add(agent.group);\n                agent.group.position.set(\n                    worldPos.x - elevator.carGroup.position.x,\n                    0,\n                    worldPos.z - elevator.carGroup.position.z\n                );\n                action.phase = \"toSpot\";\n                action._prevPos.copy(agent.group.position);\n                action._stallT = 0;\n            }\n            return false;\n        }\n\n        if (action.phase === \"toSpot\") {\n            const spotTarget = new THREE.Vector3(action.spot.x, 0, action.spot.z);\n            const res = moveToward(agent.group.position, spotTarget, WALK_SPEED * 1.15, dt);\n            if (Math.hypot(res.dx, res.dz) > 0.001) {\n                agent.group.rotation.y = Math.atan2(res.dx, res.dz);\n            }\n            const moved = Math.hypot(\n                agent.group.position.x - action._prevPos.x,\n                agent.group.position.z - action._prevPos.z\n            );\n            action._prevPos.copy(agent.group.position);\n            if (moved < 0.005) {\n                action._stallT += dt;\n                if (action._stallT > 1.5) {\n                    agent.group.position.x = spotTarget.x;\n                    agent.group.position.z = spotTarget.z;\n                    res.arrived = true;\n                }\n            } else {\n                action._stallT = 0;\n            }\n\n            if (res.arrived) {\n                agent.group.position.set(action.spot.x, 0, action.spot.z);\n                agent.group.rotation.y = 0;\n                agent.group.userData.isWalking = false;\n                agent.state = \"IN_CAR\";\n                elevator.completeBoard(agent);\n                return true;\n            }\n            return false;\n        }\n    }\n\n    if (action.type === \"EXIT_ELEVATOR\") {\n        const res = moveToward(agent.group.position, action.targetPos, WALK_SPEED * 1.15, dt);\n        if (Math.hypot(res.dx, res.dz) > 0.001) {\n            agent.group.rotation.y = Math.atan2(res.dx, res.dz);\n        }\n        const moved = Math.hypot(\n            agent.group.position.x - action._prevPos.x,\n            agent.group.position.z - action._prevPos.z\n        );\n        action._prevPos.copy(agent.group.position);\n        if (moved < 0.005) {\n            action._stallT += dt;\n            if (action._stallT > 1.5) {\n                agent.group.position.x = action.targetPos.x;\n                agent.group.position.z = action.targetPos.z;\n                res.arrived = true;\n            }\n        } else {\n            action._stallT = 0;\n        }\n\n        if (res.arrived) {\n            elevator.completeDisembark(agent);\n            agent.group.userData.isWalking = false;\n            return true;\n        }\n        return false;\n    }\n\n    return true;\n}\n\nfunction updateAgent(agent, dt) {\n    if (agent.state === \"DISABLED\" || agent.state === \"GONE\") return;\n\n    if (agent.state === \"AWAY\") {\n        if (simClock.simMinute >= agent.arrivalTime) {\n            const outsidePos = world.floors[0].nodes.outside.pos;\n            agent.group.position.set(\n                outsidePos.x + randFloat(-1.1, 1.1),\n                0,\n                outsidePos.z + randFloat(-0.75, 0.75)\n            );\n            agent.group.rotation.y = Math.PI;\n            agent.currentFloor = 0;\n            scene.add(agent.group);\n            if (agent.role === \"WORKER\") {\n                agent.plan = planArriveToDesk(agent);\n            } else {\n                agent.plan = planVisitorVisit(agent);\n            }\n            agent.currentAction = null;\n        } else {\n            return;\n        }\n    }\n\n    // Worker end-of-day check while idle at desk\n    if (\n        agent.role === \"WORKER\" &&\n        agent.state === \"AT_DESK\" &&\n        simClock.simMinute >= agent.departureTime &&\n        agent.currentAction &&\n        agent.currentAction.type === \"WAIT_SIM\"\n    ) {\n        agent.plan = planLeaveBuilding(agent);\n        agent.currentAction = null;\n    }\n\n    // Action dispatch loop (up to 16 transitions per frame)\n    for (let iter = 0; iter < 16; iter++) {\n        if (!agent.currentAction) {\n            if (agent.plan.length === 0) break;\n            const next = agent.plan.shift();\n            startAction(agent, next);\n        }\n        const done = stepAction(agent, dt);\n        if (done) {\n            agent.currentAction = null;\n            if (agent.state === \"GONE\" || agent.state === \"DISABLED\") break;\n        } else {\n            break;\n        }\n    }\n}\n\nconst ENTRANCE_WPS = {\n    outside: true,\n    front_door_threshold: true,\n    entrance: true,\n    lobby_center: true\n};\n\nfunction isCollisionExempt(agent) {\n    if (agent.state === \"DISABLED\" || agent.state === \"AWAY\" || agent.state === \"GONE\") return true;\n    if (agent.group.userData.isSitting) return true;\n    if (agent.group.parent === elevator.carGroup) return true;\n    if (!agent.group.parent) return true;\n    if (agent.currentAction) {\n        if (agent.currentAction.type === \"ENTER_ELEVATOR\") return true;\n        if (\n            agent.currentAction.type === \"WALK_TO_WP\" &&\n            agent.currentAction.floor === 0 &&\n            ENTRANCE_WPS[agent.currentAction.wpName]\n        ) {\n            return true;\n        }\n    }\n    return false;\n}\n\nfunction applyCollisions() {\n    const minSep = WORLD.PERSON_R * 1.75; // ~0.7\n    const pushScalar = 0.18;\n\n    for (let i = 0; i < agents.length; i++) {\n        const a = agents[i];\n        if (isCollisionExempt(a)) continue;\n\n        for (let j = i + 1; j < agents.length; j++) {\n            const b = agents[j];\n            if (isCollisionExempt(b)) continue;\n            if (a.group.parent !== b.group.parent) continue;\n            if (Math.abs(a.group.position.y - b.group.position.y) > 1.0) continue;\n\n            let dx = a.group.position.x - b.group.position.x;\n            let dz = a.group.position.z - b.group.position.z;\n            let d = Math.hypot(dx, dz);\n\n            if (d < minSep) {\n                if (d < 1e-3) {\n                    const ang = Math.random() * Math.PI * 2;\n                    dx = Math.cos(ang);\n                    dz = Math.sin(ang);\n                    d = 1;\n                } else {\n                    dx /= d;\n                    dz /= d;\n                }\n                const overlap = (minSep - d) * pushScalar;\n                a.group.position.x += dx * overlap;\n                a.group.position.z += dz * overlap;\n                b.group.position.x -= dx * overlap;\n                b.group.position.z -= dz * overlap;\n            }\n        }\n    }\n}\n\n// --- HUD ---\n\nfunction createHUD() {\n    const panel = document.createElement(\"div\");\n    panel.style.position = \"fixed\";\n    panel.style.top = \"12px\";\n    panel.style.left = \"12px\";\n    panel.style.padding = \"12px 14px\";\n    panel.style.background = \"rgba(18, 22, 30, 0.82)\";\n    panel.style.color = \"#e8edf5\";\n    panel.style.fontFamily = \"monospace\";\n    panel.style.fontSize = \"12px\";\n    panel.style.borderRadius = \"8px\";\n    panel.style.border = \"1px solid rgba(255,255,255,0.14)\";\n    panel.style.minWidth = \"235px\";\n    panel.style.zIndex = \"100\";\n\n    const timeEl = document.createElement(\"div\");\n    timeEl.style.fontSize = \"22px\";\n    timeEl.style.fontWeight = \"bold\";\n    timeEl.style.color = \"#ffbb22\";\n    timeEl.style.marginBottom = \"8px\";\n    panel.appendChild(timeEl);\n\n    // Speed slider (log-spaced 1..600)\n    const speedLabel = document.createElement(\"div\");\n    speedLabel.textContent = \"Speed: 120x\";\n    panel.appendChild(speedLabel);\n\n    const speedSlider = document.createElement(\"input\");\n    speedSlider.type = \"range\";\n    speedSlider.min = \"0\";\n    speedSlider.max = \"100\";\n    speedSlider.value = String(Math.round((Math.log(120) / Math.log(600)) * 100));\n    speedSlider.style.width = \"100%\";\n    speedSlider.style.marginBottom = \"6px\";\n    speedSlider.addEventListener(\"input\", (event) => {\n        const frac = Number(event.target.value) / 100;\n        const val = Math.round(Math.pow(600, frac));\n        simClock.timeScale = Math.max(1, Math.min(600, val));\n        speedLabel.textContent = \"Speed: \" + simClock.timeScale + \"x\";\n    });\n    panel.appendChild(speedSlider);\n\n    // Occupancy slider (1..100)\n    const occLabel = document.createElement(\"div\");\n    occLabel.textContent = \"Occupancy: \" + targetOccupancy + \" / \" + MAX_OCCUPANCY + \" people\";\n    panel.appendChild(occLabel);\n\n    const occSlider = document.createElement(\"input\");\n    occSlider.type = \"range\";\n    occSlider.min = \"1\";\n    occSlider.max = String(MAX_OCCUPANCY);\n    occSlider.value = String(targetOccupancy);\n    occSlider.style.width = \"100%\";\n    occSlider.style.marginBottom = \"8px\";\n    occSlider.addEventListener(\"input\", (event) => {\n        targetOccupancy = Number(event.target.value);\n        occLabel.textContent = \"Occupancy: \" + targetOccupancy + \" / \" + MAX_OCCUPANCY + \" people\";\n        applyOccupancy();\n    });\n    panel.appendChild(occSlider);\n\n    const statsEl = document.createElement(\"div\");\n    statsEl.style.lineHeight = \"1.45\";\n    statsEl.style.whiteSpace = \"pre\";\n    panel.appendChild(statsEl);\n\n    document.body.appendChild(panel);\n    hudEls.timeEl = timeEl;\n    hudEls.statsEl = statsEl;\n}\n\nfunction updateHUD() {\n    if (!hudEls.timeEl) return;\n    hudEls.timeEl.textContent = simClock.format();\n\n    const counts = {};\n    for (let i = 0; i < agents.length; i++) {\n        const s = agents[i].state;\n        counts[s] = (counts[s] || 0) + 1;\n    }\n\n    const dirChar = elevator.direction > 0 ? \"^\" : (elevator.direction < 0 ? \"v\" : \"-\");\n    const dests = Array.from(elevator.destinations).sort().join(\",\") || \"-\";\n    const ups = Array.from(elevator.upCalls).sort().join(\",\") || \"-\";\n    const dns = Array.from(elevator.downCalls).sort().join(\",\") || \"-\";\n\n    const lines = [\n        \"Present: \" + countPresent() + \" / \" + targetOccupancy,\n        \"Elevator: F\" + elevator.currentFloor + \" \" + dirChar + \" (\" + elevator.state + \")\",\n        \"Car: \" + elevator.passengers.size + \"/4  Dests:[\" + dests + \"]\",\n        \"Calls: U[\" + ups + \"] D[\" + dns + \"]\",\n        \"AT_DESK:\" + (counts.AT_DESK || 0) + \" MEET:\" + (counts.IN_MEETING || 0),\n        \"WAIT:\" + (counts.WAITING_ELEVATOR || 0) + \" VISIT:\" + (counts.VISITING || 0),\n        \"LUNCH:\" + (counts.AT_LUNCH || 0) + \" BREAK:\" + (counts.AT_BREAK || 0)\n    ];\n    hudEls.statsEl.textContent = lines.join(\"\\n\");\n}\n\nfunction startSimulation() {\n    scene = new THREE.Scene();\n    scene.background = new THREE.Color(0x20242a);\n    camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);\n    camera.position.set(28, 24, 28);\n\n    renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n    renderer.setSize(window.innerWidth, window.innerHeight);\n    renderer.sortObjects = true;\n    document.body.appendChild(renderer.domElement);\n\n    controls = new THREE.OrbitControls(camera, renderer.domElement);\n    controls.target.set(0, 9, 0);\n    controls.update();\n\n    ambientLight = new THREE.AmbientLight(0xffffff, 0.45);\n    scene.add(ambientLight);\n\n    hemiLight = new THREE.HemisphereLight(0xbfd7ff, 0x303020, 0.45);\n    scene.add(hemiLight);\n\n    sunLight = new THREE.DirectionalLight(0xffffff, 0.9);\n    sunLight.position.set(20, 35, 18);\n    scene.add(sunLight);\n\n    world = createWorld(scene);\n    elevator = new Elevator(scene, world);\n    createAgents();\n    createHUD();\n\n    window.addEventListener(\"resize\", () => {\n        camera.aspect = window.innerWidth / window.innerHeight;\n        camera.updateProjectionMatrix();\n        renderer.setSize(window.innerWidth, window.innerHeight);\n    });\n\n    const frameClock = new THREE.Clock();\n\n    function animate() {\n        requestAnimationFrame(animate);\n        const realDt = Math.min(0.05, frameClock.getDelta());\n        simClock.tick(realDt);\n        updateLighting(simClock.simMinute);\n\n        const motionDt = realDt * simClock.timeScale;\n        elevator.tick(motionDt);\n\n        topUpVisitors();\n        for (let i = 0; i < agents.length; i++) {\n            updateAgent(agents[i], motionDt);\n        }\n\n        applyCollisions();\n\n        for (let i = 0; i < agents.length; i++) {\n            const a = agents[i];\n            if (a.group.parent) {\n                animatePersonWalking(a.group, motionDt);\n            }\n        }\n\n        controls.update();\n        renderer.render(scene, camera);\n        updateHUD();\n    }\n\n    animate();\n}\n\nif (document.readyState === \"loading\") {\n    window.addEventListener(\"DOMContentLoaded\", startSimulation);\n} else {\n    startSimulation();\n}\n"}}],"api":"openai-completions","provider":"openrouter","model":"google/gemini-4-hydrogen","usage":{"input":2716,"output":17733,"cacheRead":48613,"cacheWrite":0,"reasoning":3160,"totalTokens":69062,"cost":{"input":0.0016296,"output":0.062065499999999996,"cacheRead":0.007778080000000001,"cacheWrite":0,"total":0.140717475,"totalFromProvider":true}},"stopReason":"toolUse","timestamp":1794669192812,"responseId":"gen-1794669192-YK7wFEoqx6RjXcI4CEX7","rawStopReason":"tool_calls","durationMs":106971,"thinkingLevel":"medium"}}
{"type":"tool_execution_start","toolCallId":"call_16883636211271184123","toolName":"write","args":{"path":"sim.js","content":"let scene = null;\nlet camera = null;\nlet renderer = null;\nlet controls = null;\nlet world = null;\nlet elevator = null;\nlet sunLight = null;\nlet ambientLight = null;\nlet hemiLight = null;\n\nconst MAX_WORKERS = 20;\nconst MAX_VISITORS = 80;\nconst MAX_OCCUPANCY = MAX_WORKERS + MAX_VISITORS;\nconst DEFAULT_OCCUPANCY = 45;\nconst WALK_SPEED = 1.35;\n\nlet targetOccupancy = DEFAULT_OCCUPANCY;\nconst agents = [];\nconst seatReservations = new Set();\nconst hudEls = {};\n\nconst FIRST_NAMES = [\n    \"Alex\", \"Sam\", \"Jordan\", \"Taylor\", \"Morgan\", \"Casey\", \"Riley\", \"Jamie\",\n    \"Drew\", \"Avery\", \"Quinn\", \"Blake\", \"Reese\", \"Parker\", \"Skyler\", \"Rowan\",\n    \"Elena\", \"Marcus\", \"Priya\", \"Liam\", \"Noah\", \"Maya\", \"Zoe\", \"Leo\",\n    \"Nora\", \"Owen\", \"Chloe\", \"Ethan\", \"Ruby\", \"Miles\"\n];\n\nfunction randInt(min, max) {\n    return Math.floor(Math.random() * (max - min + 1)) + min;\n}\n\nfunction randFloat(min, max) {\n    return Math.random() * (max - min) + min;\n}\n\nfunction pickRandom(arr) {\n    return arr[Math.floor(Math.random() * arr.length)];\n}\n\nconst simClock = {\n    simMinute: 7 * 60 + 30,\n    timeScale: 120,\n    tick: function (realDt) {\n        this.simMinute += (realDt * this.timeScale) / 60;\n        if (this.simMinute >= 24 * 60) {\n            this.simMinute -= 24 * 60;\n            resetDay();\n        }\n    },\n    format: function () {\n        const total = Math.floor(this.simMinute) % (24 * 60);\n        const h24 = Math.floor(total / 60);\n        const m = total % 60;\n        const ampm = h24 >= 12 ? \"PM\" : \"AM\";\n        let h12 = h24 % 12;\n        if (h12 === 0) h12 = 12;\n        const hStr = h12 < 10 ? \" \" + h12 : String(h12);\n        const mStr = m < 10 ? \"0\" + m : String(m);\n        return hStr + \":\" + mStr + \" \" + ampm;\n    }\n};\n\nconst LIGHTING_KEYFRAMES = [\n    { h: 0.0,  bg: 0x151822, sun: 0x334466, si: 0.12, ai: 0.45, hi: 0.32 },\n    { h: 5.5,  bg: 0x1a1e2e, sun: 0x445577, si: 0.15, ai: 0.45, hi: 0.32 },\n    { h: 6.0,  bg: 0x5d4a66, sun: 0xff8844, si: 0.45, ai: 0.50, hi: 0.38 },\n    { h: 6.5,  bg: 0x87b5d6, sun: 0xfff0d4, si: 0.90, ai: 0.52, hi: 0.48 },\n    { h: 12.0, bg: 0x99c8e8, sun: 0xffffff, si: 1.00, ai: 0.55, hi: 0.50 },\n    { h: 17.5, bg: 0x87b5d6, sun: 0xffe8c2, si: 0.88, ai: 0.52, hi: 0.46 },\n    { h: 18.0, bg: 0x6b4b63, sun: 0xff7733, si: 0.45, ai: 0.48, hi: 0.36 },\n    { h: 18.5, bg: 0x1c2030, sun: 0x334466, si: 0.14, ai: 0.45, hi: 0.32 },\n    { h: 24.0, bg: 0x151822, sun: 0x334466, si: 0.12, ai: 0.45, hi: 0.32 }\n];\n\nconst _tmpColorA = new THREE.Color();\nconst _tmpColorB = new THREE.Color();\n\nfunction updateLighting(simMinute) {\n    const h = (simMinute / 60) % 24;\n    let k0 = LIGHTING_KEYFRAMES[0];\n    let k1 = LIGHTING_KEYFRAMES[LIGHTING_KEYFRAMES.length - 1];\n    for (let i = 0; i < LIGHTING_KEYFRAMES.length - 1; i++) {\n        if (h >= LIGHTING_KEYFRAMES[i].h && h <= LIGHTING_KEYFRAMES[i + 1].h) {\n            k0 = LIGHTING_KEYFRAMES[i];\n            k1 = LIGHTING_KEYFRAMES[i + 1];\n            break;\n        }\n    }\n    const span = Math.max(0.0001, k1.h - k0.h);\n    const t = Math.max(0, Math.min(1, (h - k0.h) / span));\n\n    _tmpColorA.setHex(k0.bg);\n    _tmpColorB.setHex(k1.bg);\n    scene.background.copy(_tmpColorA).lerp(_tmpColorB, t);\n\n    _tmpColorA.setHex(k0.sun);\n    _tmpColorB.setHex(k1.sun);\n    sunLight.color.copy(_tmpColorA).lerp(_tmpColorB, t);\n\n    sunLight.intensity = k0.si + (k1.si - k0.si) * t;\n    ambientLight.intensity = k0.ai + (k1.ai - k0.ai) * t;\n    hemiLight.intensity = k0.hi + (k1.hi - k0.hi) * t;\n}\n\nfunction rollWorkerSchedule(agent) {\n    agent.arrivalTime = randInt(8 * 60 + 15, 9 * 60 + 30);\n    agent.lunchTime = randInt(11 * 60 + 30, 13 * 60 + 15);\n    agent.lunchDuration = randInt(25, 60);\n    agent.hasLunched = false;\n    if (Math.random() < 0.15) {\n        agent.departureTime = randInt(18 * 60 + 30, 19 * 60 + 45);\n    } else {\n        agent.departureTime = randInt(16 * 60 + 45, 18 * 60 + 30);\n    }\n    agent.plannedMeetingTimes = [];\n    const mCount = randInt(0, 2);\n    if (mCount >= 1) agent.plannedMeetingTimes.push(randInt(9 * 60 + 45, 11 * 60 + 15));\n    if (mCount >= 2) agent.plannedMeetingTimes.push(randInt(13 * 60 + 45, 16 * 60 + 15));\n}\n\nfunction rollVisitorSchedule(agent, baseMin) {\n    const start = baseMin !== undefined ? baseMin : 8 * 60 + 15;\n    agent.arrivalTime = start + randInt(0, 6);\n    agent.visitDuration = randInt(8, 28);\n    agent.lunchTime = 9999;\n    agent.lunchDuration = 0;\n    agent.hasLunched = true;\n    agent.departureTime = 9999;\n    agent.plannedMeetingTimes = [];\n}\n\nfunction createAgents() {\n    let idCounter = 0;\n    // 20 Workers (floors 1..5, 4 desks each)\n    for (let f = 1; f < WORLD.FLOOR_COUNT; f++) {\n        const fl = world.floors[f];\n        for (let d = 0; d < fl.desks.length; d++) {\n            const desk = fl.desks[d];\n            const mesh = createPerson();\n            const agent = {\n                id: idCounter++,\n                role: \"WORKER\",\n                name: pickRandom(FIRST_NAMES),\n                homeFloor: f,\n                deskId: desk.id,\n                deskWpName: desk.deskWpName,\n                deskDoorWpName: desk.doorWpName,\n                group: mesh,\n                state: \"AWAY\",\n                currentFloor: 0,\n                plan: [],\n                currentAction: null,\n                reservedSeatKey: null\n            };\n            rollWorkerSchedule(agent);\n            agents.push(agent);\n        }\n    }\n\n    // 80 Visitors\n    for (let v = 0; v < MAX_VISITORS; v++) {\n        const mesh = createPerson();\n        const agent = {\n            id: idCounter++,\n            role: \"VISITOR\",\n            name: pickRandom(FIRST_NAMES),\n            homeFloor: null,\n            deskId: null,\n            deskWpName: null,\n            deskDoorWpName: null,\n            group: mesh,\n            state: \"AWAY\",\n            currentFloor: 0,\n            plan: [],\n            currentAction: null,\n            reservedSeatKey: null\n        };\n        rollVisitorSchedule(agent, 8 * 60 + randInt(0, 120));\n        agents.push(agent);\n    }\n\n    applyOccupancy();\n}\n\nfunction releaseSeat(agent) {\n    if (agent.reservedSeatKey) {\n        seatReservations.delete(agent.reservedSeatKey);\n        agent.reservedSeatKey = null;\n    }\n}\n\nfunction reserveConfSeat(floor) {\n    for (let i = 0; i < 4; i++) {\n        const wpName = \"conf_seat\" + i;\n        const key = floor + \":\" + wpName;\n        if (!seatReservations.has(key)) {\n            seatReservations.add(key);\n            return { key: key, wpName: wpName };\n        }\n    }\n    return null;\n}\n\nfunction applyOccupancy() {\n    for (let i = 0; i < agents.length; i++) {\n        const a = agents[i];\n        if (a.id < targetOccupancy) {\n            if (a.state === \"DISABLED\") {\n                a.state = \"AWAY\";\n            }\n        } else {\n            if (a.state === \"AWAY\" || a.state === \"GONE\") {\n                a.state = \"DISABLED\";\n                if (a.group.parent) a.group.parent.remove(a.group);\n            }\n        }\n    }\n}\n\nfunction countPresent() {\n    let count = 0;\n    for (let i = 0; i < agents.length; i++) {\n        const s = agents[i].state;\n        if (s !== \"DISABLED\" && s !== \"AWAY\" && s !== \"GONE\") {\n            count++;\n        }\n    }\n    return count;\n}\n\nfunction topUpVisitors() {\n    if (simClock.simMinute < 7 * 60 + 30 || simClock.simMinute > 18 * 60 + 30) return;\n    const deficit = targetOccupancy - countPresent();\n    if (deficit <= 0) return;\n\n    let armed = 0;\n    for (let i = 0; i < agents.length; i++) {\n        const a = agents[i];\n        if (a.role !== \"VISITOR\" || a.id >= targetOccupancy) continue;\n        if (a.state === \"GONE\" || (a.state === \"AWAY\" && a.arrivalTime > simClock.simMinute + 12)) {\n            rollVisitorSchedule(a, simClock.simMinute);\n            a.state = \"AWAY\";\n            armed++;\n            if (armed >= deficit) break;\n        }\n    }\n}\n\nfunction resetDay() {\n    seatReservations.clear();\n    if (elevator) elevator.reset();\n\n    for (let i = 0; i < agents.length; i++) {\n        const a = agents[i];\n        if (a.group.parent) a.group.parent.remove(a.group);\n        a.group.userData.isWalking = false;\n        a.group.userData.isSitting = false;\n        a.plan = [];\n        a.currentAction = null;\n        a.reservedSeatKey = null;\n        a.currentFloor = 0;\n\n        if (a.role === \"WORKER\") {\n            rollWorkerSchedule(a);\n        } else {\n            rollVisitorSchedule(a, 8 * 60 + randInt(0, 90));\n        }\n        a.state = a.id < targetOccupancy ? \"AWAY\" : \"DISABLED\";\n    }\n}\n\n// --- Plan Compilers ---\n\nfunction addElevatorTrip(plan, fromFloor, toFloor) {\n    if (fromFloor === toFloor) return;\n    const dir = toFloor > fromFloor ? 1 : -1;\n    plan.push({ type: \"WALK_TO_WP\", floor: fromFloor, wpName: \"elevWait\" });\n    plan.push({ type: \"WAIT_AT_PANEL\", floor: fromFloor, dir: dir, toFloor: toFloor });\n    plan.push({ type: \"ENTER_ELEVATOR\", toFloor: toFloor });\n    plan.push({ type: \"PRESS_FLOOR\", floor: toFloor });\n    plan.push({ type: \"WAIT_FOR_FLOOR\", floor: toFloor });\n    plan.push({ type: \"EXIT_ELEVATOR\", toFloor: toFloor });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n}\n\nfunction planArriveToDesk(agent) {\n    const plan = [];\n    plan.push({ type: \"ENTER_STATE\", state: \"ARRIVING\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"front_door_threshold\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"entrance\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"lobby_center\" });\n    addElevatorTrip(plan, 0, agent.homeFloor);\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"SIT\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"ENTER_STATE\", state: \"AT_DESK\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(20, 55) });\n    plan.push({ type: \"PICK_NEXT_ACTIVITY\" });\n    return plan;\n}\n\nfunction planGoToLunch(agent) {\n    const plan = [];\n    const cafeSpots = world.floors[0].cafeSpots;\n    const bistroWp = pickRandom(cafeSpots);\n\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    addElevatorTrip(plan, agent.homeFloor, 0);\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: bistroWp });\n    plan.push({ type: \"SIT\", floor: 0, wpName: bistroWp });\n    plan.push({ type: \"ENTER_STATE\", state: \"AT_LUNCH\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: agent.lunchDuration });\n    plan.push({ type: \"MARK_LUNCHED\" });\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    addElevatorTrip(plan, 0, agent.homeFloor);\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"SIT\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"ENTER_STATE\", state: \"AT_DESK\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(20, 50) });\n    plan.push({ type: \"PICK_NEXT_ACTIVITY\" });\n    return plan;\n}\n\nfunction planVisitLounge(agent) {\n    const plan = [];\n    const spots = [\"lounge_spot0\", \"lounge_spot1\", \"lounge_spot2\", \"water_cooler\"];\n    const spot = pickRandom(spots);\n\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: spot });\n    plan.push({ type: \"SIT\", floor: agent.homeFloor, wpName: spot });\n    plan.push({ type: \"ENTER_STATE\", state: \"AT_BREAK\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(5, 12) });\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"SIT\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"ENTER_STATE\", state: \"AT_DESK\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(18, 50) });\n    plan.push({ type: \"PICK_NEXT_ACTIVITY\" });\n    return plan;\n}\n\nfunction planAttendMeeting(agent) {\n    const meetFloor = Math.random() < 0.65 ? agent.homeFloor : randInt(1, WORLD.FLOOR_COUNT - 1);\n    const seat = reserveConfSeat(meetFloor);\n    if (!seat) {\n        return planVisitLounge(agent);\n    }\n    agent.reservedSeatKey = seat.key;\n\n    const plan = [];\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    addElevatorTrip(plan, agent.homeFloor, meetFloor);\n    plan.push({ type: \"WALK_TO_WP\", floor: meetFloor, wpName: seat.wpName });\n    plan.push({ type: \"SIT\", floor: meetFloor, wpName: seat.wpName });\n    plan.push({ type: \"ENTER_STATE\", state: \"IN_MEETING\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(22, 45) });\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"RELEASE_SEAT\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    addElevatorTrip(plan, meetFloor, agent.homeFloor);\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"SIT\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"ENTER_STATE\", state: \"AT_DESK\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(18, 50) });\n    plan.push({ type: \"PICK_NEXT_ACTIVITY\" });\n    return plan;\n}\n\nfunction planVisitCoworker(agent) {\n    const candidates = [];\n    for (let i = 0; i < agents.length; i++) {\n        const other = agents[i];\n        if (other !== agent && other.role === \"WORKER\" && other.state === \"AT_DESK\") {\n            candidates.push(other);\n        }\n    }\n    if (candidates.length === 0) {\n        return planVisitLounge(agent);\n    }\n    const target = pickRandom(candidates);\n    const plan = [];\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    addElevatorTrip(plan, agent.homeFloor, target.homeFloor);\n    plan.push({ type: \"WALK_TO_WP\", floor: target.homeFloor, wpName: target.deskDoorWpName });\n    plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(6, 18) });\n    plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n    addElevatorTrip(plan, target.homeFloor, agent.homeFloor);\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskDoorWpName });\n    plan.push({ type: \"WALK_TO_WP\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"SIT\", floor: agent.homeFloor, wpName: agent.deskWpName });\n    plan.push({ type: \"ENTER_STATE\", state: \"AT_DESK\" });\n    plan.push({ type: \"WAIT_SIM\", minutes: randInt(18, 50) });\n    plan.push({ type: \"PICK_NEXT_ACTIVITY\" });\n    return plan;\n}\n\nfunction planLeaveBuilding(agent) {\n    const plan = [];\n    plan.push({ type: \"STAND\" });\n    plan.push({ type: \"RELEASE_SEAT\" });\n    plan.push({ type: \"ENTER_STATE\", state: \"LEAVING\" });\n    if (agent.currentFloor > 0) {\n        addElevatorTrip(plan, agent.currentFloor, 0);\n    }\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"lobby_center\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"entrance\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"front_door_threshold\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"outside\" });\n    plan.push({ type: \"EXIT_BUILDING\" });\n    return plan;\n}\n\nfunction planVisitorVisit(agent) {\n    const plan = [];\n    plan.push({ type: \"ENTER_STATE\", state: \"ARRIVING\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"front_door_threshold\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"entrance\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"lobby_center\" });\n\n    const r = Math.random();\n    const dur = agent.visitDuration || randInt(8, 25);\n\n    if (r < 0.10) {\n        // Bistro table\n        const wp = pickRandom(world.floors[0].cafeSpots);\n        plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: wp });\n        plan.push({ type: \"SIT\", floor: 0, wpName: wp });\n        plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n        plan.push({ type: \"WAIT_SIM\", minutes: dur });\n        plan.push({ type: \"STAND\" });\n    } else if (r < 0.16) {\n        // Cafe counter\n        plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"cafe_order\" });\n        plan.push({ type: \"SIT\", floor: 0, wpName: \"cafe_order\" });\n        plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n        plan.push({ type: \"WAIT_SIM\", minutes: randInt(4, 10) });\n        plan.push({ type: \"STAND\" });\n    } else if (r < 0.30) {\n        // Front lounge\n        const wp = pickRandom([\"front_lounge_0\", \"front_lounge_1\", \"front_lounge_2\"]);\n        plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: wp });\n        plan.push({ type: \"SIT\", floor: 0, wpName: wp });\n        plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n        plan.push({ type: \"WAIT_SIM\", minutes: dur });\n        plan.push({ type: \"STAND\" });\n    } else if (r < 0.42) {\n        // Back lounge / conversation pit\n        const wp = pickRandom([\"back_lounge_N\", \"back_lounge_S\", \"pit_N\", \"pit_S\", \"pit_E\", \"pit_W\"]);\n        plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: wp });\n        plan.push({ type: \"SIT\", floor: 0, wpName: wp });\n        plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n        plan.push({ type: \"WAIT_SIM\", minutes: dur });\n        plan.push({ type: \"STAND\" });\n    } else if (r < 0.52) {\n        // Reception / kiosk / water cooler\n        const wp = pickRandom([\"reception\", \"kiosk\", \"lobby_wc_front\", \"lobby_wc_back\"]);\n        plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: wp });\n        plan.push({ type: \"SIT\", floor: 0, wpName: wp });\n        plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n        plan.push({ type: \"WAIT_SIM\", minutes: randInt(4, 12) });\n        plan.push({ type: \"STAND\" });\n    } else if (r < 0.62) {\n        // Lobby loiter\n        const wp = pickRandom([\"lobby_stand_center\", \"lobby_stand_NE\", \"lobby_stand_NW\", \"lobby_stand_midE\", \"lobby_stand_midW\", \"lobby_stand_entry\"]);\n        plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: wp });\n        plan.push({ type: \"SIT\", floor: 0, wpName: wp });\n        plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n        plan.push({ type: \"WAIT_SIM\", minutes: randInt(5, 15) });\n        plan.push({ type: \"STAND\" });\n    } else if (r < 0.77) {\n        // Ride up to an office-floor lounge\n        const upFloor = randInt(1, WORLD.FLOOR_COUNT - 1);\n        const wp = pickRandom([\"lounge_spot0\", \"lounge_spot1\", \"lounge_spot2\", \"water_cooler\", \"hall_stand_N\", \"hall_stand_S\"]);\n        addElevatorTrip(plan, 0, upFloor);\n        plan.push({ type: \"WALK_TO_WP\", floor: upFloor, wpName: wp });\n        plan.push({ type: \"SIT\", floor: upFloor, wpName: wp });\n        plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n        plan.push({ type: \"WAIT_SIM\", minutes: randInt(6, 16) });\n        plan.push({ type: \"STAND\" });\n        plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n        addElevatorTrip(plan, upFloor, 0);\n    } else {\n        // Sit in on a meeting (23%)\n        const meetFloor = randInt(1, WORLD.FLOOR_COUNT - 1);\n        const seat = reserveConfSeat(meetFloor);\n        if (seat) {\n            agent.reservedSeatKey = seat.key;\n            addElevatorTrip(plan, 0, meetFloor);\n            plan.push({ type: \"WALK_TO_WP\", floor: meetFloor, wpName: seat.wpName });\n            plan.push({ type: \"SIT\", floor: meetFloor, wpName: seat.wpName });\n            plan.push({ type: \"ENTER_STATE\", state: \"IN_MEETING\" });\n            plan.push({ type: \"WAIT_SIM\", minutes: randInt(15, 32) });\n            plan.push({ type: \"STAND\" });\n            plan.push({ type: \"RELEASE_SEAT\" });\n            plan.push({ type: \"ENTER_STATE\", state: \"ON_FLOOR\" });\n            addElevatorTrip(plan, meetFloor, 0);\n        } else {\n            const wp = pickRandom([\"lobby_stand_center\", \"lobby_stand_NE\", \"lobby_stand_NW\"]);\n            plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: wp });\n            plan.push({ type: \"SIT\", floor: 0, wpName: wp });\n            plan.push({ type: \"ENTER_STATE\", state: \"VISITING\" });\n            plan.push({ type: \"WAIT_SIM\", minutes: randInt(6, 14) });\n            plan.push({ type: \"STAND\" });\n        }\n    }\n\n    plan.push({ type: \"ENTER_STATE\", state: \"LEAVING\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"lobby_center\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"entrance\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"front_door_threshold\" });\n    plan.push({ type: \"WALK_TO_WP\", floor: 0, wpName: \"outside\" });\n    plan.push({ type: \"EXIT_BUILDING\" });\n    return plan;\n}\n\nfunction chooseNextActivity(agent) {\n    if (simClock.simMinute >= agent.departureTime) {\n        return planLeaveBuilding(agent);\n    }\n\n    if (agent.plannedMeetingTimes && agent.plannedMeetingTimes.length > 0) {\n        for (let i = 0; i < agent.plannedMeetingTimes.length; i++) {\n            if (simClock.simMinute >= agent.plannedMeetingTimes[i]) {\n                agent.plannedMeetingTimes.splice(i, 1);\n                return planAttendMeeting(agent);\n            }\n        }\n    }\n\n    if (!agent.hasLunched && simClock.simMinute >= agent.lunchTime) {\n        return planGoToLunch(agent);\n    }\n\n    const r = Math.random();\n    if (r < 0.14) {\n        return planAttendMeeting(agent);\n    } else if (r < 0.26) {\n        return planVisitLounge(agent);\n    } else if (r < 0.41) {\n        return planVisitCoworker(agent);\n    } else {\n        return [\n            { type: \"WAIT_SIM\", minutes: randInt(18, 65) },\n            { type: \"PICK_NEXT_ACTIVITY\" }\n        ];\n    }\n}\n\n// --- Action Execution ---\n\nfunction nearestNodeName(nodes, pos) {\n    let bestName = null;\n    let bestDistSq = Infinity;\n    const keys = Object.keys(nodes);\n    for (let i = 0; i < keys.length; i++) {\n        const k = keys[i];\n        const np = nodes[k].pos;\n        const dx = np.x - pos.x;\n        const dz = np.z - pos.z;\n        const d2 = dx * dx + dz * dz;\n        if (d2 < bestDistSq) {\n            bestDistSq = d2;\n            bestName = k;\n        }\n    }\n    return bestName;\n}\n\nfunction startAction(agent, action) {\n    agent.currentAction = action;\n    if (action.type === \"WALK_TO_WP\") {\n        const nodes = world.floors[action.floor].nodes;\n        const fromName = nearestNodeName(nodes, agent.group.position);\n        action.waypoints = bfsPath(nodes, fromName, action.wpName);\n        action.wpIdx = 0;\n        action._prevPos = agent.group.position.clone();\n        action._stallT = 0;\n        agent.group.userData.isWalking = true;\n        agent.group.userData.isSitting = false;\n    } else if (action.type === \"WAIT_AT_PANEL\") {\n        agent.group.userData.isWalking = false;\n    } else if (action.type === \"ENTER_ELEVATOR\") {\n        action.phase = \"reserve\";\n        action.spot = null;\n        action._prevPos = agent.group.position.clone();\n        action._stallT = 0;\n    } else if (action.type === \"EXIT_ELEVATOR\") {\n        // Reparent from carGroup to scene preserving world position\n        const worldPos = new THREE.Vector3();\n        agent.group.getWorldPosition(worldPos);\n        scene.add(agent.group);\n        agent.group.position.copy(worldPos);\n        agent.currentFloor = action.toFloor;\n        elevator.registerDisembark(agent);\n        const elevWaitPos = world.floors[action.toFloor].nodes.elevWait.pos.clone();\n        action.targetPos = elevWaitPos;\n        action._prevPos = agent.group.position.clone();\n        action._stallT = 0;\n        agent.group.userData.isWalking = true;\n    } else if (action.type === \"WAIT_SIM\") {\n        action.untilMin = simClock.simMinute + action.minutes;\n        agent.group.userData.isWalking = false;\n    }\n}\n\nfunction moveToward(pos, target, speed, dt) {\n    const dx = target.x - pos.x;\n    const dz = target.z - pos.z;\n    const dist = Math.hypot(dx, dz);\n    if (dist <= speed * dt + 0.05) {\n        pos.x = target.x;\n        pos.z = target.z;\n        return { arrived: true, dx: dx, dz: dz };\n    }\n    const step = (speed * dt) / dist;\n    pos.x += dx * step;\n    pos.z += dz * step;\n    return { arrived: false, dx: dx, dz: dz };\n}\n\nfunction stepAction(agent, dt) {\n    const action = agent.currentAction;\n    if (!action) return true;\n\n    if (action.type === \"ENTER_STATE\") {\n        agent.state = action.state;\n        return true;\n    }\n\n    if (action.type === \"MARK_LUNCHED\") {\n        agent.hasLunched = true;\n        return true;\n    }\n\n    if (action.type === \"RELEASE_SEAT\") {\n        releaseSeat(agent);\n        return true;\n    }\n\n    if (action.type === \"PICK_NEXT_ACTIVITY\") {\n        agent.plan = chooseNextActivity(agent);\n        return true;\n    }\n\n    if (action.type === \"EXIT_BUILDING\") {\n        if (agent.group.parent) agent.group.parent.remove(agent.group);\n        agent.group.userData.isWalking = false;\n        agent.group.userData.isSitting = false;\n        agent.state = \"GONE\";\n        agent.plan = [];\n        return true;\n    }\n\n    if (action.type === \"PRESS_FLOOR\") {\n        elevator.pressDestination(action.floor);\n        return true;\n    }\n\n    if (action.type === \"WAIT_FOR_FLOOR\") {\n        agent.group.userData.isWalking = false;\n        return elevator.state === \"DOOR_OPEN\" && elevator.currentFloor === action.floor;\n    }\n\n    if (action.type === \"SIT\") {\n        const fl = world.floors[action.floor];\n        const node = fl.nodes[action.wpName];\n        const st = fl.sitTargets[action.wpName];\n        agent.group.userData.isWalking = false;\n        if (node) {\n            agent.group.position.x = node.pos.x;\n            agent.group.position.z = node.pos.z;\n        }\n        if (st && st.sit) {\n            agent.group.position.y = action.floor * WORLD.FLOOR_HEIGHT - 0.35;\n            agent.group.rotation.y = st.facing;\n            agent.group.userData.isSitting = true;\n        } else {\n            // Standing waypoint: jitter in small ring so visitors don't stack identically\n            const angle = Math.random() * Math.PI * 2;\n            const radius = randFloat(0.35, 0.75);\n            agent.group.position.x += Math.cos(angle) * radius;\n            agent.group.position.z += Math.sin(angle) * radius;\n            agent.group.position.y = action.floor * WORLD.FLOOR_HEIGHT;\n            if (st) agent.group.rotation.y = st.facing;\n            agent.group.userData.isSitting = false;\n        }\n        return true;\n    }\n\n    if (action.type === \"STAND\") {\n        agent.group.userData.isSitting = false;\n        if (agent.group.parent === elevator.carGroup) {\n            agent.group.position.y = 0;\n        } else {\n            agent.group.position.y = agent.currentFloor * WORLD.FLOOR_HEIGHT;\n        }\n        return true;\n    }\n\n    if (action.type === \"WAIT_SIM\") {\n        return simClock.simMinute >= action.untilMin;\n    }\n\n    if (action.type === \"WALK_TO_WP\") {\n        if (!action.waypoints || action.wpIdx >= action.waypoints.length) {\n            agent.group.userData.isWalking = false;\n            return true;\n        }\n        const target = action.waypoints[action.wpIdx];\n        const res = moveToward(agent.group.position, target, WALK_SPEED, dt);\n        agent.group.position.y = action.floor * WORLD.FLOOR_HEIGHT;\n        if (Math.hypot(res.dx, res.dz) > 0.001) {\n            agent.group.rotation.y = Math.atan2(res.dx, res.dz);\n        }\n\n        const moved = Math.hypot(\n            agent.group.position.x - action._prevPos.x,\n            agent.group.position.z - action._prevPos.z\n        );\n        action._prevPos.copy(agent.group.position);\n        if (moved < 0.005) {\n            action._stallT += dt;\n            const stallLimit = action.wpName === \"front_door_threshold\" ? 1.5 : 1.2;\n            if (action._stallT > stallLimit) {\n                action._stallT = 0;\n                action.wpIdx++;\n                if (action.wpIdx >= action.waypoints.length) {\n                    agent.group.position.x = target.x;\n                    agent.group.position.z = target.z;\n                    agent.group.userData.isWalking = false;\n                    return true;\n                }\n                return false;\n            }\n        } else {\n            action._stallT = 0;\n        }\n\n        if (res.arrived) {\n            action.wpIdx++;\n            action._stallT = 0;\n            if (action.wpIdx >= action.waypoints.length) {\n                agent.group.userData.isWalking = false;\n                return true;\n            }\n        }\n        return false;\n    }\n\n    if (action.type === \"WAIT_AT_PANEL\") {\n        agent.state = \"WAITING_ELEVATOR\";\n        if (action.dir > 0) elevator.callUp(action.floor);\n        else elevator.callDown(action.floor);\n\n        if (elevator.isAcceptingAt(action.floor, action.dir) && elevator.currentCapacityFree() > 0) {\n            return true;\n        }\n        return false;\n    }\n\n    if (action.type === \"ENTER_ELEVATOR\") {\n        if (action.phase === \"reserve\") {\n            const dir = action.toFloor > agent.currentFloor ? 1 : -1;\n            if (!elevator.isAcceptingAt(agent.currentFloor, dir)) {\n                if (dir > 0) elevator.callUp(agent.currentFloor);\n                else elevator.callDown(agent.currentFloor);\n                return false;\n            }\n            const spot = elevator.reserveBoardingSpot(agent);\n            if (!spot) {\n                if (dir > 0) elevator.callUp(agent.currentFloor);\n                else elevator.callDown(agent.currentFloor);\n                return false;\n            }\n            action.spot = spot;\n            action.phase = \"toDoor\";\n            action._prevPos.copy(agent.group.position);\n            action._stallT = 0;\n            agent.group.userData.isWalking = true;\n            return false;\n        }\n\n        if (action.phase === \"toDoor\") {\n            const doorTarget = new THREE.Vector3(\n                action.spot.x,\n                agent.currentFloor * WORLD.FLOOR_HEIGHT,\n                1.55\n            );\n            const res = moveToward(agent.group.position, doorTarget, WALK_SPEED * 1.15, dt);\n            if (Math.hypot(res.dx, res.dz) > 0.001) {\n                agent.group.rotation.y = Math.atan2(res.dx, res.dz);\n            }\n            const moved = Math.hypot(\n                agent.group.position.x - action._prevPos.x,\n                agent.group.position.z - action._prevPos.z\n            );\n            action._prevPos.copy(agent.group.position);\n            if (moved < 0.005) {\n                action._stallT += dt;\n                if (action._stallT > 1.5) {\n                    agent.group.position.x = doorTarget.x;\n                    agent.group.position.z = doorTarget.z;\n                    res.arrived = true;\n                }\n            } else {\n                action._stallT = 0;\n            }\n\n            if (res.arrived) {\n                const worldPos = agent.group.position.clone();\n                elevator.carGroup.add(agent.group);\n                agent.group.position.set(\n                    worldPos.x - elevator.carGroup.position.x,\n                    0,\n                    worldPos.z - elevator.carGroup.position.z\n                );\n                action.phase = \"toSpot\";\n                action._prevPos.copy(agent.group.position);\n                action._stallT = 0;\n            }\n            return false;\n        }\n\n        if (action.phase === \"toSpot\") {\n            const spotTarget = new THREE.Vector3(action.spot.x, 0, action.spot.z);\n            const res = moveToward(agent.group.position, spotTarget, WALK_SPEED * 1.15, dt);\n            if (Math.hypot(res.dx, res.dz) > 0.001) {\n                agent.group.rotation.y = Math.atan2(res.dx, res.dz);\n            }\n            const moved = Math.hypot(\n                agent.group.position.x - action._prevPos.x,\n                agent.group.position.z - action._prevPos.z\n            );\n            action._prevPos.copy(agent.group.position);\n            if (moved < 0.005) {\n                action._stallT += dt;\n                if (action._stallT > 1.5) {\n                    agent.group.position.x = spotTarget.x;\n                    agent.group.position.z = spotTarget.z;\n                    res.arrived = true;\n                }\n            } else {\n                action._stallT = 0;\n            }\n\n            if (res.arrived) {\n                agent.group.position.set(action.spot.x, 0, action.spot.z);\n                agent.group.rotation.y = 0;\n                agent.group.userData.isWalking = false;\n                agent.state = \"IN_CAR\";\n                elevator.completeBoard(agent);\n                return true;\n            }\n            return false;\n        }\n    }\n\n    if (action.type === \"EXIT_ELEVATOR\") {\n        const res = moveToward(agent.group.position, action.targetPos, WALK_SPEED * 1.15, dt);\n        if (Math.hypot(res.dx, res.dz) > 0.001) {\n            agent.group.rotation.y = Math.atan2(res.dx, res.dz);\n        }\n        const moved = Math.hypot(\n            agent.group.position.x - action._prevPos.x,\n            agent.group.position.z - action._prevPos.z\n        );\n        action._prevPos.copy(agent.group.position);\n        if (moved < 0.005) {\n            action._stallT += dt;\n            if (action._stallT > 1.5) {\n                agent.group.position.x = action.targetPos.x;\n                agent.group.position.z = action.targetPos.z;\n                res.arrived = true;\n            }\n        } else {\n            action._stallT = 0;\n        }\n\n        if (res.arrived) {\n            elevator.completeDisembark(agent);\n            agent.group.userData.isWalking = false;\n            return true;\n        }\n        return false;\n    }\n\n    return true;\n}\n\nfunction updateAgent(agent, dt) {\n    if (agent.state === \"DISABLED\" || agent.state === \"GONE\") return;\n\n    if (agent.state === \"AWAY\") {\n        if (simClock.simMinute >= agent.arrivalTime) {\n            const outsidePos = world.floors[0].nodes.outside.pos;\n            agent.group.position.set(\n                outsidePos.x + randFloat(-1.1, 1.1),\n                0,\n                outsidePos.z + randFloat(-0.75, 0.75)\n            );\n            agent.group.rotation.y = Math.PI;\n            agent.currentFloor = 0;\n            scene.add(agent.group);\n            if (agent.role === \"WORKER\") {\n                agent.plan = planArriveToDesk(agent);\n            } else {\n                agent.plan = planVisitorVisit(agent);\n            }\n            agent.currentAction = null;\n        } else {\n            return;\n        }\n    }\n\n    // Worker end-of-day check while idle at desk\n    if (\n        agent.role === \"WORKER\" &&\n        agent.state === \"AT_DESK\" &&\n        simClock.simMinute >= agent.departureTime &&\n        agent.currentAction &&\n        agent.currentAction.type === \"WAIT_SIM\"\n    ) {\n        agent.plan = planLeaveBuilding(agent);\n        agent.currentAction = null;\n    }\n\n    // Action dispatch loop (up to 16 transitions per frame)\n    for (let iter = 0; iter < 16; iter++) {\n        if (!agent.currentAction) {\n            if (agent.plan.length === 0) break;\n            const next = agent.plan.shift();\n            startAction(agent, next);\n        }\n        const done = stepAction(agent, dt);\n        if (done) {\n            agent.currentAction = null;\n            if (agent.state === \"GONE\" || agent.state === \"DISABLED\") break;\n        } else {\n            break;\n        }\n    }\n}\n\nconst ENTRANCE_WPS = {\n    outside: true,\n    front_door_threshold: true,\n    entrance: true,\n    lobby_center: true\n};\n\nfunction isCollisionExempt(agent) {\n    if (agent.state === \"DISABLED\" || agent.state === \"AWAY\" || agent.state === \"GONE\") return true;\n    if (agent.group.userData.isSitting) return true;\n    if (agent.group.parent === elevator.carGroup) return true;\n    if (!agent.group.parent) return true;\n    if (agent.currentAction) {\n        if (agent.currentAction.type === \"ENTER_ELEVATOR\") return true;\n        if (\n            agent.currentAction.type === \"WALK_TO_WP\" &&\n            agent.currentAction.floor === 0 &&\n            ENTRANCE_WPS[agent.currentAction.wpName]\n        ) {\n            return true;\n        }\n    }\n    return false;\n}\n\nfunction applyCollisions() {\n    const minSep = WORLD.PERSON_R * 1.75; // ~0.7\n    const pushScalar = 0.18;\n\n    for (let i = 0; i < agents.length; i++) {\n        const a = agents[i];\n        if (isCollisionExempt(a)) continue;\n\n        for (let j = i + 1; j < agents.length; j++) {\n            const b = agents[j];\n            if (isCollisionExempt(b)) continue;\n            if (a.group.parent !== b.group.parent) continue;\n            if (Math.abs(a.group.position.y - b.group.position.y) > 1.0) continue;\n\n            let dx = a.group.position.x - b.group.position.x;\n            let dz = a.group.position.z - b.group.position.z;\n            let d = Math.hypot(dx, dz);\n\n            if (d < minSep) {\n                if (d < 1e-3) {\n                    const ang = Math.random() * Math.PI * 2;\n                    dx = Math.cos(ang);\n                    dz = Math.sin(ang);\n                    d = 1;\n                } else {\n                    dx /= d;\n                    dz /= d;\n                }\n                const overlap = (minSep - d) * pushScalar;\n                a.group.position.x += dx * overlap;\n                a.group.position.z += dz * overlap;\n                b.group.position.x -= dx * overlap;\n                b.group.position.z -= dz * overlap;\n            }\n        }\n    }\n}\n\n// --- HUD ---\n\nfunction createHUD() {\n    const panel = document.createElement(\"div\");\n    panel.style.position = \"fixed\";\n    panel.style.top = \"12px\";\n    panel.style.left = \"12px\";\n    panel.style.padding = \"12px 14px\";\n    panel.style.background = \"rgba(18, 22, 30, 0.82)\";\n    panel.style.color = \"#e8edf5\";\n    panel.style.fontFamily = \"monospace\";\n    panel.style.fontSize = \"12px\";\n    panel.style.borderRadius = \"8px\";\n    panel.style.border = \"1px solid rgba(255,255,255,0.14)\";\n    panel.style.minWidth = \"235px\";\n    panel.style.zIndex = \"100\";\n\n    const timeEl = document.createElement(\"div\");\n    timeEl.style.fontSize = \"22px\";\n    timeEl.style.fontWeight = \"bold\";\n    timeEl.style.color = \"#ffbb22\";\n    timeEl.style.marginBottom = \"8px\";\n    panel.appendChild(timeEl);\n\n    // Speed slider (log-spaced 1..600)\n    const speedLabel = document.createElement(\"div\");\n    speedLabel.textContent = \"Speed: 120x\";\n    panel.appendChild(speedLabel);\n\n    const speedSlider = document.createElement(\"input\");\n    speedSlider.type = \"range\";\n    speedSlider.min = \"0\";\n    speedSlider.max = \"100\";\n    speedSlider.value = String(Math.round((Math.log(120) / Math.log(600)) * 100));\n    speedSlider.style.width = \"100%\";\n    speedSlider.style.marginBottom = \"6px\";\n    speedSlider.addEventListener(\"input\", (event) => {\n        const frac = Number(event.target.value) / 100;\n        const val = Math.round(Math.pow(600, frac));\n        simClock.timeScale = Math.max(1, Math.min(600, val));\n        speedLabel.textContent = \"Speed: \" + simClock.timeScale + \"x\";\n    });\n    panel.appendChild(speedSlider);\n\n    // Occupancy slider (1..100)\n    const occLabel = document.createElement(\"div\");\n    occLabel.textContent = \"Occupancy: \" + targetOccupancy + \" / \" + MAX_OCCUPANCY + \" people\";\n    panel.appendChild(occLabel);\n\n    const occSlider = document.createElement(\"input\");\n    occSlider.type = \"range\";\n    occSlider.min = \"1\";\n    occSlider.max = String(MAX_OCCUPANCY);\n    occSlider.value = String(targetOccupancy);\n    occSlider.style.width = \"100%\";\n    occSlider.style.marginBottom = \"8px\";\n    occSlider.addEventListener(\"input\", (event) => {\n        targetOccupancy = Number(event.target.value);\n        occLabel.textContent = \"Occupancy: \" + targetOccupancy + \" / \" + MAX_OCCUPANCY + \" people\";\n        applyOccupancy();\n    });\n    panel.appendChild(occSlider);\n\n    const statsEl = document.createElement(\"div\");\n    statsEl.style.lineHeight = \"1.45\";\n    statsEl.style.whiteSpace = \"pre\";\n    panel.appendChild(statsEl);\n\n    document.body.appendChild(panel);\n    hudEls.timeEl = timeEl;\n    hudEls.statsEl = statsEl;\n}\n\nfunction updateHUD() {\n    if (!hudEls.timeEl) return;\n    hudEls.timeEl.textContent = simClock.format();\n\n    const counts = {};\n    for (let i = 0; i < agents.length; i++) {\n        const s = agents[i].state;\n        counts[s] = (counts[s] || 0) + 1;\n    }\n\n    const dirChar = elevator.direction > 0 ? \"^\" : (elevator.direction < 0 ? \"v\" : \"-\");\n    const dests = Array.from(elevator.destinations).sort().join(\",\") || \"-\";\n    const ups = Array.from(elevator.upCalls).sort().join(\",\") || \"-\";\n    const dns = Array.from(elevator.downCalls).sort().join(\",\") || \"-\";\n\n    const lines = [\n        \"Present: \" + countPresent() + \" / \" + targetOccupancy,\n        \"Elevator: F\" + elevator.currentFloor + \" \" + dirChar + \" (\" + elevator.state + \")\",\n        \"Car: \" + elevator.passengers.size + \"/4  Dests:[\" + dests + \"]\",\n        \"Calls: U[\" + ups + \"] D[\" + dns + \"]\",\n        \"AT_DESK:\" + (counts.AT_DESK || 0) + \" MEET:\" + (counts.IN_MEETING || 0),\n        \"WAIT:\" + (counts.WAITING_ELEVATOR || 0) + \" VISIT:\" + (counts.VISITING || 0),\n        \"LUNCH:\" + (counts.AT_LUNCH || 0) + \" BREAK:\" + (counts.AT_BREAK || 0)\n    ];\n    hudEls.statsEl.textContent = lines.join(\"\\n\");\n}\n\nfunction startSimulation() {\n    scene = new THREE.Scene();\n    scene.background = new THREE.Color(0x20242a);\n    camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);\n    camera.position.set(28, 24, 28);\n\n    renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });\n    renderer.setSize(window.innerWidth, window.innerHeight);\n    renderer.sortObjects = true;\n    document.body.appendChild(renderer.domElement);\n\n    controls = new THREE.OrbitControls(camera, renderer.domElement);\n    controls.target.set(0, 9, 0);\n    controls.update();\n\n    ambientLight = new THREE.AmbientLight(0xffffff, 0.45);\n    scene.add(ambientLight);\n\n    hemiLight = new THREE.HemisphereLight(0xbfd7ff, 0x303020, 0.45);\n    scene.add(hemiLight);\n\n    sunLight = new THREE.DirectionalLight(0xffffff, 0.9);\n    sunLight.position.set(20, 35, 18);\n    scene.add(sunLight);\n\n    world = createWorld(scene);\n    elevator = new Elevator(scene, world);\n    createAgents();\n    createHUD();\n\n    window.addEventListener(\"resize\", () => {\n        camera.aspect = window.innerWidth / window.innerHeight;\n        camera.updateProjectionMatrix();\n        renderer.setSize(window.innerWidth, window.innerHeight);\n    });\n\n    const frameClock = new THREE.Clock();\n\n    function animate() {\n        requestAnimationFrame(animate);\n        const realDt = Math.min(0.05, frameClock.getDelta());\n        simClock.tick(realDt);\n        updateLighting(simClock.simMinute);\n\n        const motionDt = realDt * simClock.timeScale;\n        elevator.tick(motionDt);\n\n        topUpVisitors();\n        for (let i = 0; i < agents.length; i++) {\n            updateAgent(agents[i], motionDt);\n        }\n\n        applyCollisions();\n\n        for (let i = 0; i < agents.length; i++) {\n            const a = agents[i];\n            if (a.group.parent) {\n                animatePersonWalking(a.group, motionDt);\n            }\n        }\n\n        controls.update();\n        renderer.render(scene, camera);\n        updateHUD();\n    }\n\n    animate();\n}\n\nif (document.readyState === \"loading\") {\n    window.addEventListener(\"DOMContentLoaded\", startSimulation);\n} else {\n    startSimulation();\n}\n"}}
